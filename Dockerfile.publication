# Separate viewer image: no working outputs, pipeline code or dashboard settings.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 DPV_ACCESS_MODE=publication
WORKDIR /app
RUN pip install --no-cache-dir "starlette>=0.47,<1" "uvicorn[standard]>=0.35,<1"
COPY dpv_dashboard/__init__.py dpv_dashboard/access.py dpv_dashboard/publication.py ./dpv_dashboard/
CMD exec uvicorn dpv_dashboard.publication:app --host 0.0.0.0 --port ${PORT:-8080}
