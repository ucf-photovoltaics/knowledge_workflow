# Papers that did EL (electroluminescence) imaging of PERC cells.
# Scans titles, canonical/paper concept terms, and every property value/quote.
PREFIX schema: <https://schema.org/>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX mds:    <https://cwrusdle.bitbucket.io/mds/generic/>

SELECT DISTINCT ?doi ?title ?domain ?doiUrl
WHERE {
  ?paper schema:identifier ?doi .
  OPTIONAL { ?paper schema:name    ?title  }
  OPTIONAL { ?paper mds:hasDomain  ?domain }
  OPTIONAL { ?paper owl:sameAs     ?doiUrl }

  # --- must mention electroluminescence / EL imaging somewhere ---------------
  FILTER EXISTS {
    {           ?paper schema:name ?elT }
    UNION {     ?paper mds:hasConcept/mds:canonicalTerm ?elT }
    UNION {     ?paper mds:hasConcept/mds:paperTerm     ?elT }
    UNION {     ?paper ?pe ?en . ?en mds:value ?elT }
    UNION {     ?paper ?pe ?en . ?en mds:quote ?elT }
    FILTER(REGEX(STR(?elT), "electroluminescence|\\bEL\\b|EL[ -]?imag", "i"))
  }

  # --- must mention PERC (Passivated Emitter and Rear Cell) -------------------
  FILTER EXISTS {
    {           ?paper schema:name ?pcT }
    UNION {     ?paper mds:hasConcept/mds:canonicalTerm ?pcT }
    UNION {     ?paper mds:hasConcept/mds:paperTerm     ?pcT }
    UNION {     ?paper ?pp ?pn . ?pn mds:value ?pcT }
    UNION {     ?paper ?pp ?pn . ?pn mds:quote ?pcT }
    FILTER(REGEX(STR(?pcT), "\\bPERC\\b|passivated emitter", "i"))
  }
}
ORDER BY ?doi
