<https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/ontology>
    a owl:Ontology ;
    rdfs:label "in development electron microscopy review sem contact corrosion Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the -in_development-_>_electron_microscopy_review_>_sem-contact-corrosion domain."@en ;
    dcterms:created "2026-06-23"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

