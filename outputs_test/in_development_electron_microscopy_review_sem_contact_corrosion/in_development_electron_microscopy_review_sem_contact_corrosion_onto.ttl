# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasMaterialInterface>
    a owl:DatatypeProperty ;
    rdfs:label "material interface"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    skos:example "silver/silicon interface"@en ;
    .

