      "schema:identifier": "10.1109/JPHOTOV.2025.3531052",
      "mds:hasDomain": "-in_development-_>_electron_microscopy_review_>_sem-contact-corrosion",
      "mds:derivedFrom": "schema_in_development_electron_microscopy_review_sem_contact_corrosion-Brent_Thompson-v8-20260623.csv",
      "schema:name": "Characterization of Field-Exposed Photovoltaic Modules Featuring Signs of Contact Degradation",
      "owl:sameAs": {
        "@id": "https://doi.org/10.1109/JPHOTOV.2025.3531052"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasMaterialInterface": {
        "mds:value": "the performance of the photovoltaic module greatly depends on the functionality of this material interface"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasContactMaterialDegradation": {
        "mds:value": "screen-printed contacts may undergo severe degradation under high temperature–high humidity environmental stress"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasInterfaceDetachment": {
        "mds:value": "interfacial delamination of the top layer from the substrate has been observed for some commercial samples"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasIonPenetration": {
        "mds:value": "during HTHT, sodium ions, which are present in acetic acid as a contaminant source, penetrate through the metallization and reach the busbars at higher temperatures"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasCorrosionResistanceTestMethod": {
        "mds:value": "In this study, we used an exposure to acetic acid vapor under hygrothermal conditions with two different levels of temperature and time for inducing degradation in silicon photovoltaic cells."
      },
      "https://cwrusdle.bitbucket.io/mds/material/PassivationLayer": {
        "mds:value": "The passivation of the emitter surface using a phosphosilicate glass (PSG) is used to reduce the recombination loss at grain boundaries and enhance lifetime"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasMultiscaleCharacterizationApproach": {
        "mds:value": "Here, we use multiscale characterization (from individual grains to full modules) to uncover degradation mechanisms and quantify the effects of acetic acid on silicon photovoltaic cells."
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasLocalResistanceImagingTechnique": {
        "mds:value": "A series local resistance imaging technique has been developed to measure the resistivity at the contact–emitter interface, which is indicative of potential degradation"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasReciprocalDensityMeasurement": {
        "mds:value": "+ Reciprocal density measurement of ultrasonic reflectors, which correlates with voiding within metallization layers (Figure 4(a))"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasMetallizationArchitecture": {
        "mds:value": "For Si-based PV cells, the most common metallization architectures involve screen-printed busbars and fingers."
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasResistiveBarrierThicknessMeasurement": {
        "mds:value": "However, local resistive barriers, such as those forming around soldering balls, may influence module performance. To diagnose potential hotspots, a non-destructive method of measuring resistive barrier thickness is presented"
      },
      "https://cwrusdle.bitbucket.io/mds/measurement/SeriesResistance": {
        "mds:value": "This loss can be explained by the increased series resistance due to degrading metallization"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasDiagnosticMethod": {
        "mds:value": "High Resolution Spatial Characterisation (HRSC) and Infrared Lock-In Thermography (ILIT)"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasDegradationRootCauseIdentificationMethod": {
        "mds:value": "The degradation can be identified by combining several diagnostic methods including multiscale characterization of photovoltaic modules"
      },
      "https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/hasStructuralChange": {
        "mds:value": "In this work, HTHT was performed to assess the stability of silicon modules under a temperature range of 90°C and relative humidity (RH) of 85%."
