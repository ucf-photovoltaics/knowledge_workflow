# ── Domain record class ──────────────────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord>
    a owl:Class ;
    rdfs:label "CharacterizationAndMetrologySpatiallyResolvedCharacterizationUvf Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the characterization_and_metrology_>_spatially-resolved_characterization_>_uvf domain."@en ;
    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/hasBacksheet>
    a owl:DatatypeProperty ;
    rdfs:label "backsheet"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Backsheet> ;
    skos:definition "Outermost layer for a solar panel, protecting it from harsh, varying environmental conditions over panel lifetimes."@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/Backsheet> ;
    skos:example "the backsheet are not photobleached."@en ;
    .

