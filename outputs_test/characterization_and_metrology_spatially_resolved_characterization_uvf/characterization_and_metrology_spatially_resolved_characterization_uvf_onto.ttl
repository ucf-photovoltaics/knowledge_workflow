<https://cwrusdle.bitbucket.io/mds/generic/DataAnalysisProcess>
    a owl:Class ;
    rdfs:label ">#> data analysis process"@en ;
    skos:prefLabel ">#> data analysis process"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000015> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/DefectDetectionMethod>
    a owl:Class ;
    rdfs:label "defect_detection_method"@en ;
    skos:prefLabel "defect_detection_method"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Process> ;
    skos:example "electrical detection of gap formation"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/DefectDetectionMethods>
    a owl:Class ;
    rdfs:label ">#> defect detection methods"@en ;
    skos:prefLabel ">#> defect detection methods"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Defect> ;
    skos:definition "An Immaterial Entity that disrupts the continuity of unit cell repetition in a solid substance.; (Elucidation) A Defect is conceptualized to be some region (or a discontinuous aggregate of regions) in a material in direct contact with a crystal, that contains or lacks material entities in a way that disrupts the repeating patterns of a perfect crystal."@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/Defect> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/DefectType>
