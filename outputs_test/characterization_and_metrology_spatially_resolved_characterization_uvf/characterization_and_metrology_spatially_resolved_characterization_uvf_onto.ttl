<https://cwrusdle.bitbucket.io/mds/generic/ontology>
    a owl:Ontology ;
    rdfs:label "characterization and metrology spatially resolved characterization uvf Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the characterization_and_metrology_>_spatially-resolved_characterization_>_uvf domain."@en ;
    dcterms:created "2026-06-24"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Measurement>
