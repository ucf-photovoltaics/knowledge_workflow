<https://cwrusdle.bitbucket.io/mds/generic/Backsheet>
    a owl:Class ;
    rdfs:label "backsheet"@en ;
    skos:prefLabel "backsheet"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/generic/PvModule> ;
    skos:definition "Outermost layer for a solar panel, protecting it from harsh, varying environmental conditions over panel lifetimes."@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/Backsheet> ;
    skos:example "the backsheet are not photobleached."@en ;
    .

