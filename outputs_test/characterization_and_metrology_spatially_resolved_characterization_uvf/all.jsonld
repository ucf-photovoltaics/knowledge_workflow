        "mds:value": "crack",
        "mds:quote": "Besides the seasonal variation of the UVF intensity increase over the middle of the cell, a seasonal variation of the photo-bleaching extent for both EV As was observed."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/DegradationMechanism": {
        "mds:value": "+ text"
      },
