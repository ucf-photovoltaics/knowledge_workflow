# -- Object properties + concept relations (from REBEL) ---

<https://cwrusdle.bitbucket.io/mds/subClassOf>
    a owl:ObjectProperty ;
    rdfs:label "subClassOf"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/TandemCellArchitecture> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://cwrusdle.bitbucket.io/mds/subClassOf> ; owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/generic/SolarCellType> ] .
