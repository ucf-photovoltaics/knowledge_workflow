    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/material/AbsorberMaterial>
    a owl:DatatypeProperty ;
    rdfs:label "absorber material"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    skos:example "perovskite"@en ,
        "silicon/silicon nitride (Si/SiN) pairs"@en ,
        "perovskite/Si tandem system"@en ,
        "perovskite top cell material (1.66 eV bandgap)"@en ,
