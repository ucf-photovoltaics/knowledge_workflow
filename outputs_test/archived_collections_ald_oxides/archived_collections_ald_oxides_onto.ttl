    a owl:Class ;
    rdfs:label "atomic_layer_deposition"@en ;
    skos:prefLabel "atomic_layer_deposition"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Material> ;
    .

