@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/generic/> .

<https://cwrusdle.bitbucket.io/mds/generic/ontology>
    a owl:Ontology ;
    rdfs:label "archived collections ald oxides Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the -archived_collections-_>_ald_oxides domain."@en ;
    dcterms:created "2026-06-24"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Concept>
    a owl:Class ;
    rdfs:label "Concept"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/Measurement>
    a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Material>
    a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Process>
    a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Device>
    a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Characterization>
    a owl:Class ;
    rdfs:label "Characterization"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Reliability>
    a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Characterization> ;
    .

<https://cwrusdle.bitbucket.io/mds/Sample>
    a owl:Class ;
    rdfs:label "Sample"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Economics>
    a owl:Class ;
    rdfs:label "Economics"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/ResearchPublication>
    a owl:Class ;
    rdfs:label "ResearchPublication"@en ;
    .

# ── Domain record class ──────────────────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord>
    a owl:Class ;
    rdfs:label "ArchivedCollectionsAldOxides Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the -archived_collections-_>_ald_oxides domain."@en ;
    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/hasAtomicLayerDeposition>
    a owl:DatatypeProperty ;
    rdfs:label "atomic_layer_deposition"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasOpticalProperties>
    a owl:DatatypeProperty ;
    rdfs:label "optical_properties"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasRecombinationVelocity>
    a owl:DatatypeProperty ;
    rdfs:label "recombination_velocity"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasPassivationAcceleration>
    a owl:DatatypeProperty ;
    rdfs:label "passivation_acceleration"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasRefractiveIndex>
    a owl:DatatypeProperty ;
    rdfs:label "refractive_index"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasSurfacePassivation>
    a owl:DatatypeProperty ;
    rdfs:label "surface_passivation"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Characterization> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasTitaniumOxide>
    a owl:DatatypeProperty ;
    rdfs:label "titanium_oxide"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    .

<https://cwrusdle.bitbucket.io/mds/material/OpticalProperties>
    a owl:DatatypeProperty ;
    rdfs:label "optical properties"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:example "TiO2 has ideal optical properties (refractive index of //24 2.4 and a relatively low absorption in the visible range) to be used as ARC for encapsulated silicon wafer solar cells."@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasPassivationVelocity>
    a owl:DatatypeProperty ;
    rdfs:label "passivation velocity"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:example "ultralow effective surface recombination velocities down to 2.8 cm/s and 8.3 cm/s, respectively"@en ;
    .

# -- Concept classes (domain taxonomy) --------------------

