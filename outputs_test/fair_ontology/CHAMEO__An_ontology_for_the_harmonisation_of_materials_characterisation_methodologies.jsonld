  "https://cwrusdle.bitbucket.io/mds/generic/hasOntologicalFramework": {
    "mds:value": "CHAMEO ontology",
    "mds:quote": "This work is part of a broader initiative under the umbrella of the European Materials Modelling Council (EMMC), for the development of interconnected materials modelling ontologies based on a common root that is the Elementary Multiperspective Material Ontology (EMMO)."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasMaterialsCharacterisation": {
    "mds:value": "material characterisation encompasses a wide range of methods and related research communities",
    "mds:quote": "The field of materials characterisation encompasses a wide range of methods and related research communities."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasOntologyDevelopment": {
    "mds:value": "CHAMEO ontology",
    "mds:quote": "This work presents a domain ontology designed to model the common aspects across the different characterisation methodologies."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasLinkedData": {
    "mds:value": "CHADA documentation scheme",
    "mds:quote": "This ontology, called the CHAMEO ontology, is based on a recent CEN Workshop Agreement (CWA 17815) which introduced a standardised terminology and the Characterisation Data (CHADA) documentation scheme."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasResearchContribution": {
    "mds:value": "This work is part of a broader initiative under the umbrella of the European Materials Modelling Council (EMMC)",
    "mds:quote": "This work is part of a broader initiative under the umbrella of the European Materials Modelling Council (EMMC), for the development of interconnected materials modelling ontologies based on a common root that is the Elementary Multiperspective Material Ontology (EMMO)."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasMethodologyHarmonization": {
    "mds:value": "harmonising the underlying method-specific ontologies",
    "mds:quote": "The goal of CHAMEO is to provide a framework for harmonising the underlying method-specific ontologies, which can be developed by reusing and specialising the generic constructs of the CHAMEO ontology."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasDataClassification": {
    "mds:value": "CHADA documentation scheme",
    "mds:quote": "This ontology, called the CHAMEO ontology, is based on a recent CEN Workshop Agreement (CWA 17815) which introduced a standardised terminology and the Characterisation Data (CHADA) documentation scheme."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/hasMaterialsModellingDomain": {
    "mds:value": "This work is part of a broader initiative under the umbrella of the European Materials Modelling Council (EMMC), for the development of interconnected materials modelling ontologies based on a common root that is the Elementary Multiperspective Material Ontology (EMMO)."
