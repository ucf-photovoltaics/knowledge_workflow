      "schema:identifier": "10.1016/j.websem.2012.02.001",
      "mds:hasDomain": "fair-ontology",
      "mds:derivedFrom": "schema_fair_ontology-Brent_Thompson-v8-20260623.csv",
      "schema:name": "An empirical survey of Linked Data conformance",
      "owl:sameAs": {
        "@id": "https://doi.org/10.1016/j.websem.2012.02.001"
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasDataProvider": {
        "mds:value": "currently available Linked Data",
        "mds:quote": "Linked Data guidelines are designed to facilitate ad hoc re-use and integration of conformant structured data–across the Web–by consumer applications; however, thus far, systems have yet to emerge that convincingly demonstrate the potential applications for consuming currently available Linked Data."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasDataPublishing": {
        "mds:value": "the result of",
        "mds:quote": "There has been a recent, tangible growth in RDF published on the Web in accordance with the Linked Data principles and best practices, the result of which has been dubbed the “Web of Data”."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasMetrics": {
        "mds:value": "broadly adhered to (esp. use HTTP URIs, keep URIs stable), whilst others are commonly overlooked (esp. provide licencing and human-readable meta-data).",
        "mds:quote": "We show that certain guidelines are broadly adhered to (esp. use HTTP URIs, keep URIs stable), whilst others are commonly overlooked (esp. provide licencing and human-readable meta-data)."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasTaxonomyProperty": {
        "mds:value": "+ stable,",
        "mds:quote": "Our evaluation is based on quantitative empirical analyses of a crawl of ∼4 million RDF/XML documents constituting over 1 billion quadruples, where we also look at the stability of hosted documents for a corpus consisting of nine monthly snapshots from a sample of 151 thousand documents."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasInformationArchitecture": {
        "mds:value": "the different guidelines, and present the top-ranked data providers in terms of a combined PageRank and Linked Data conformance score.",
        "mds:quote": "Finally, we present a summary of conformance for the different guidelines, and present the top-ranked data providers in terms of a combined PageRank and Linked Data conformance score."
      },
      "https://cwrusdle.bitbucket.io/mds/generic/hasCorpusStabilityAnalysis": {
        "mds:value": "Our evaluation is based on quantitative empirical analyses of a crawl of ∼4 million RDF/XML documents constituting over 1 billion quadruples, where we also look at the stability of hosted documents for a corpus consisting of nine monthly snapshots from a sample of 151 thousand documents."
      },
