@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/generic/> .

<https://cwrusdle.bitbucket.io/mds/generic/ontology>
    a owl:Ontology ;
    rdfs:label "fair ontology Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the fair-ontology domain."@en ;
    dcterms:created "2026-06-23"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Concept>
    a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    .

<https://cwrusdle.bitbucket.io/mds/Measurement>
    a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    .

<https://cwrusdle.bitbucket.io/mds/Material>
