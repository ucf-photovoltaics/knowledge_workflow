    rdfs:label "SurfacePassivation Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the surface_passivation domain."@en ;
    .

