      },
      "https://cwrusdle.bitbucket.io/mds/generic/ElectronicCharacterization": {
        "mds:value": "combined with electrical characterization.",
        "mds:quote": "The characteristics of passivation in various cleaning procedure were investigated by modern"
      },
      "https://cwrusdle.bitbucket.io/mds/generic/DevicePerformance": {
        "mds:value": "improved electrical characteristics were achieved",
        "mds:quote": "Electrical measurements of MOSCAP with HfTiO/4 nm-Al2O3/InGaAs structure indicated improved electrical characteristics were achieved."
      },
