  "@id": "https://cwrusdle.bitbucket.io/mds/generic/Comprehensive_design_of_a_100-kilowatt_solar_power_plant_with_bifacial_technology_in_PVsyst_for_Arak__Iran",
  "@type": [
    "mds:ResearchPublication",
    "mds:SchemaRecord"
  ],
  "schema:identifier": "10.1016/j.seja.2025.100092",
  "mds:hasDomain": "pv_performance_modeling",
  "mds:derivedFrom": "schema_pv_performance_modeling-Brent_Thompson-v8-20260624.csv",
  "schema:name": "Comprehensive design of a 100-kilowatt solar power plant with bifacial technology in PVsyst for Arak, Iran",
  "owl:sameAs": {
    "@id": "https://doi.org/10.1016/j.seja.2025.100092"
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Albedo": {
    "mds:value": "10%",
    "mds:quote": "The albedo is the measure of reflectance, representing 10% for most typical scenarios."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Cable": {
    "mds:value": "12 AWG",
    "mds:quote": "DC/AC combiner boxes are connected to the main panel via a 12-AWG (1.6 mm2) copper cable with an overall length less than 30 m, and all AC components are also placed nearby."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Capacity": {
    "mds:value": "5000W",
    "mds:quote": "The maximum capacity is set at 5000 W based upon typical grid interconnection requirements and system load size."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Coatings": {
    "mds:value": "silver-coated reflective film",
    "mds:quote": "Solar cells were mounted on a glass substrate with a thin layer of a silver-coated reflective film below the SiO2 coating to avoid overheating during illumination tests."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Connection": {
    "mds:value": "series",
    "mds:quote": "For all the considered cases, DC cables connection between panels has been considered parallel while series configuration between cells and sub-modules respectively."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Efficiency": {
    "mds:value": "15.6%",
    "mds:quote": "The highest peak power obtained for a module with an efficiency of about 15.6% was measured in 1 min with the mentioned above conditions, which is lower than the one reported by (Dey et al., [30])."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/Energy": {
    "mds:value": "2 MWh/yr",
    "mds:quote": "Based on energy production cost that is considered about $0.017 per kWh. Therefore annual life-cycle savings can be calculated by multiplying the mentioned factors with one-year expected operating hours of 10,000 h. Consequently, it can be shown that the total annual energy production from this array can reach to 2 MWh/yr."
  },
  "https://cwrusdle.bitbucket.io/mds/generic/FillFactor": {
    "mds:value": "78.57%",
    "mds:quote": "For comparison, this system used about half of modules with a fill-factor as low as 78.57%."
  },
