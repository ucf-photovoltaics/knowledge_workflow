        "mds:value": "solar radiation & temperature measurements"
      },
      "https://cwrusdle.bitbucket.io/mds/generic/Capacity": {
        "mds:value": "installed MW & grid_connection capacity",
        "mds:quote": "+ grid connection allowed system to reach 70% of its installed capacity . Malvoni et al., 2017."
      },
