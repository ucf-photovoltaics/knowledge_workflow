# ── Domain record class ──────────────────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord>
    a owl:Class ;
    rdfs:label "ArchivedCollectionsPhotonManagementCellPerformance Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the -archived_collections-_>_photon_management_>_cell_performance domain."@en ;
    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/hasBackSurfaceReEctor>
    a owl:DatatypeProperty ;
    rdfs:label "back_surface_reﬂector"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Characterization> ;
    skos:example "rear surface reﬂector"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasCellStructure>
    a owl:DatatypeProperty ;
    rdfs:label "cell_structure"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Device> ;
    skos:example "PERC cell"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasChangedBackSurfaceReEctorToConceptLevelAlsoNormalizedSomeOtherConceptsByChangingWordPositionFromBeforeAfterHyphenEGCellTestingMethodsBecamePerformanceTestingMethodsNoteNotIncludedThisChangeForAllWordsNormalizedAFewWordsInTheListWhichWereMisspelledOrWrongSoOnlyTheFollowingAreAdded>
    a owl:DatatypeProperty ;
    rdfs:label "><!-- changed back_surface_reﬂector to concept level, also normalized some other concepts by changing word position from before/after hyphen - e.g. cell-testing-methods became performance_testing_methods (note: not included this change for all words)- normalized a few words in the list which were misspelled or wrong so only the following are added -->"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Position> ;
    skos:definition "Position of ---"@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/Position> ;
    .

