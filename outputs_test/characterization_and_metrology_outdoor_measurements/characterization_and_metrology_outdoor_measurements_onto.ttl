# ── Domain record class ──────────────────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord>
    a owl:Class ;
    rdfs:label "CharacterizationAndMetrologyOutdoorMeasurements Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the characterization_and_metrology_>_outdoor_measurements domain."@en ;
    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/generic/hasRenewableEnergySystem>
    a owl:DatatypeProperty ;
    rdfs:label "renewable energy system"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:example "PV systems"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasPhotovoltaicSystem>
    a owl:DatatypeProperty ;
    rdfs:label "photovoltaic system"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:definition "An Electrical Power Source that consists in part of one or more Solar Panels, a power inverter, electrical wiring between the components, a mounting and support structure, and may also include a battery and/or a solar tracking system and is the bearer of functions realized in processes of deriving, transferring, and storing electrical energy derived from light energy."@en ;
    skos:exactMatch <https://www.commoncoreontologies.org/ont00001222> ;
    skos:example "PV systems detection and diagnostics"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasSolarPanel>
    a owl:DatatypeProperty ;
    rdfs:label "solar panel"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:definition "An Electrical Power Source that consists in part of one or more photovoltaic (i.e. solar) cells that convert light energy (photons) directly into electricity by means of the photovoltaic effect."@en ;
    skos:exactMatch <https://www.commoncoreontologies.org/ont00000843> ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/hasTemperatureMeasurement>
    a owl:DatatypeProperty ;
    rdfs:label "temperature measurement"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Process> ;
    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy.; A Quality that inheres in a bearer in virtue of its thermal energy"@en ;
    skos:exactMatch <https://www.commoncoreontologies.org/ont00000441> ;
    skos:example "temperature-independent spectral indices"@en ;
    .

