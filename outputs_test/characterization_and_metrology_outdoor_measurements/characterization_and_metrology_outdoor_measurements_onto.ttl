<https://cwrusdle.bitbucket.io/mds/generic/ontology>
    a owl:Ontology ;
    rdfs:label "characterization and metrology outdoor measurements Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the characterization_and_metrology_>_outdoor_measurements domain."@en ;
    dcterms:created "2026-06-24"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Measurement>
    a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Material>
