    rdfs:label "InDevelopmentSemiconductorAbsorbers Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the -in_development-_>_semiconductor_absorbers domain."@en ;
    .

