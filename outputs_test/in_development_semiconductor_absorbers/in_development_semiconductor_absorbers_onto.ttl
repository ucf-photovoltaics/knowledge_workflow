<https://cwrusdle.bitbucket.io/mds/characterization/electronmicroscopy/ontology>
    a owl:Ontology ;
    rdfs:label "in development semiconductor absorbers Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the -in_development-_>_semiconductor_absorbers domain."@en ;
    dcterms:created "2026-06-24"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Concept>
