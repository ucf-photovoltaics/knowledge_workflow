    rdfs:label "el artículo presenta estudio comparativo sobre resultados obtenidos con diferentes equipos de espectrómetro, enfocado a la calidad de panel solar y sus componentes internos."@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/generic/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

