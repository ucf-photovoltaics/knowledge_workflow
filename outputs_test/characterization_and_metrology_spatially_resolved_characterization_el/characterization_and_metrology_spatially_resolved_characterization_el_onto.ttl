<https://cwrusdle.bitbucket.io/mds/generic/DefectDetection>
    a owl:Class ;
    rdfs:label "defect detection"@en ;
    skos:prefLabel "defect detection"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Defect> ;
    skos:definition "An Immaterial Entity that disrupts the continuity of unit cell repetition in a solid substance.; (Elucidation) A Defect is conceptualized to be some region (or a discontinuous aggregate of regions) in a material in direct contact with a crystal, that contains or lacks material entities in a way that disrupts the repeating patterns of a perfect crystal."@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/Defect> ;
    skos:example "in-situ defect and damage determination of crystalline silicon"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/FaultIdentification>
    a owl:Class ;
    rdfs:label "fault identification"@en ;
    skos:prefLabel "fault identification"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    skos:example "identification of micro-cracks in photovoltaic modules through electroluminescence imaging under a forward voltage"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/PhotovoltaicModule>
    a owl:Class ;
    rdfs:label "photovoltaic module"@en ;
    skos:prefLabel "photovoltaic module"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/generic/PvModule> ;
    skos:definition "A photovoltaic module is a collection of solar cell circuits sealed in an environmentally protective laminate. Packaging of modules typically includes layering cells between materials such as glass for the front and back, a top and rear encapsulation layer, cells and interconnects, passivation layers and optical coatings, all enclosed in a metal frame. Performance of PV modules are generally rated according to their electrical outputs under standard test conditions. Modules are used in the field together as arrays that make up a power generation site."@en ;
    skos:exactMatch <https://cwrusdle.bitbucket.io/mds/PhotovoltaicModule> ;
    skos:example "Photovoltaic (PV) modules"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/generic/SolarPanelDefects>
