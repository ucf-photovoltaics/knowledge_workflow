                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                    owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/CuringTemperature>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                    owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/CuringTime>
                                                                  ] ;
                                                  rdfs:label "Thermal Curing"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "Heat Curing" ,
                                                                                                 "Thermal Polymerization" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A process that uses heat to initiate or accelerate a chemical reaction that hardens or sets a material, commonly used for polymers, composites, and coatings."@en ;
                                                  <https://cwrusdle.bitbucket.io/mds/hasDomain> "Manufacture"@en ;
                                                  <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Materials Processing" ;
                                                  <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "MatProc"@en .


