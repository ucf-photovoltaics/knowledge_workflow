###  https://cwrusdle.bitbucket.io/mds/DirectMetalDeposition
<https://cwrusdle.bitbucket.io/mds/DirectMetalDeposition> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/MaterialsProcessing> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                            owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/CarrierGas>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                            owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/LaserPowerParameter>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                            owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/PowderFeedRate>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                            owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/TrackOverlap>
                                                                          ] ;
                                                          <http://purl.org/dc/terms/source> "ISO/ASTM 52900:2021" ;
                                                          rdfs:label "Direct Metal Deposition"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#altLabel> "DED" ,
                                                                                                         "DMD" ,
                                                                                                         "Direct Energy Deposition" ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "An additive manufacturing process that uses a focused thermal energy source to fuse materials by melting as they are deposited."@en ;
