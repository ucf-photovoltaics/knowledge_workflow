                                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                                           owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasValue> ;
                                                                                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                                owl:onDatatype xsd:float ;
                                                                                                                                                                owl:withRestrictions ( [ xsd:minInclusive "0.5"^^xsd:float
                                                                                                                                                                                       ]
                                                                                                                                                                                       [ xsd:maxInclusive "3.0"^^xsd:float
                                                                                                                                                                                       ]
                                                                                                                                                                                     )
                                                                                                                                                              ]
                                                                                                                                         ]
                                                                                                                                       ) ;
                                                                                                                    rdf:type owl:Class
                                                                                                                  ]
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <https://cwrusdle.bitbucket.io/mds/unit> ;
                                                                                               owl:hasValue <http://qudt.org/vocab/unit/EV>
                                                                                             ]
                                                                                           ) ;
                                                                        rdf:type owl:Class
                                                                      ] ;
                                                  rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Material> ;
                                                  rdfs:label "Semiconductor" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A Material with Electronic Band Gap between 0.5 eV and 3.0 eV" .


