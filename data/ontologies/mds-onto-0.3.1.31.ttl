                                                                                                                   owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/AmorphousPhase>
                                                                                                                 ]
                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                   owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasPhase> ;
                                                                                                                   owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/CrystallinePhase>
                                                                                                                 ]
                                                                                                               ) ;
                                                                                            rdf:type owl:Class
                                                                                          ] ;
                                                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                                      rdfs:label "PartiallyCrystallineMetallicAlloy" ;
                                                                      <http://www.w3.org/2004/02/skos/core#altLabel> " " ;
                                                                      <http://www.w3.org/2004/02/skos/core#definition> " " ;
                                                                      <https://cwrusdle.bitbucket.io/mds/hasDomain> "Charact" ;
                                                                      <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Sample" ;
                                                                      <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "Material-XRD" .


