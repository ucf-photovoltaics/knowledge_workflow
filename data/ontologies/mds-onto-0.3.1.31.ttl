@base <https://cwrusdle.bitbucket.io/mds/Ontology#> .

<https://cwrusdle.bitbucket.io/mds/Ontology> rdf:type owl:Ontology ;
                                              <http://purl.org/dc/terms/creator> "SDLE Research Center" ;
                                              <http://purl.org/dc/terms/description> "MDS-Onto is a domain (low) level ontology that describes terms in Materials Data Science. It is divided into six large modules: BuiltEnv, Exposure, Chemistry, Manufacture, Characterization, and Geospatial. Under each module, there are multiple sub-modules such as FTIR, AFM, Chem-Rxn, PV-Module, Accelerated Exposure, etc. " ;
                                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-sa/4.0/> ;
                                              <http://purl.org/dc/terms/title> "MDS-Onto" ;
                                              rdfs:label "MDS-Onto" ;
                                              owl:versionInfo "0.3.1.29" .

