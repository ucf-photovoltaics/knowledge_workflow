                                                         rdfs:label "PhotovoltaicModuleID" ;
                                                         <http://www.w3.org/2004/02/skos/core#altLabel> "Module ID" ,
                                                                                                        "PV Module ID" ,
                                                                                                        "Photovoltaic Module ID" ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "Unique identifier given to solar panel." ;
                                                         <https://cwrusdle.bitbucket.io/mds/hasDomain> "BuiltEnv" ,
                                                                                                       "Exposure" ,
                                                                                                       "NetSEM" ;
                                                         <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Sample" ;
                                                         <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "" ,
                                                                                                          "Acelerated" ,
