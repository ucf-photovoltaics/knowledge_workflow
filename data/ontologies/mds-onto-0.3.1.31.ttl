<http://purl.obolibrary.org/obo/CHMO_0001709> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/CHMO_0001718
<http://purl.obolibrary.org/obo/CHMO_0001718> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHMO_0001709> ;
                                              rdfs:label "evaporative light scattering detection"@en ;
                                              <http://www.w3.org/2004/02/skos/core#altLabel> "ELSD"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A detection method where a liquid containing the sample is atomised in a gas, forming small droplets which are allowed to evaporate leaving the sample as fine particles. The suspended particles pass through a light beam and the scattered light transmitted by the particles is sensed by a photomultiplier. The response is proportional to the mass of the molecules in the sample.[CHMO]"@en ;
                                              <https://cwrusdle.bitbucket.io/mds/hasDomain> "Chem"@en ;
                                              <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Analysis" ;
                                              <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "Chem-Rxn"@en .


###  http://purl.obolibrary.org/obo/CHMO_0002004
<http://purl.obolibrary.org/obo/CHMO_0002004> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHMO_0000470> ;
