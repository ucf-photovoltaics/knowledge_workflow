                                                     rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
                                                     rdfs:label "AnalyticalResult"@en ;
                                                     <http://www.w3.org/2004/02/skos/core#altLabel> " " ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "An analytical result is an information content entity that is about the outcome of an analysis process. The analysis process can be a characterization method (UV-VIS or NMR) or a data analysis method such as calculating the mean/average."@en ;
                                                     <http://www.w3.org/2004/02/skos/core#example> "In the chemical reaction context, an analytical result is an information content entity that is about a product (output) of a chemical reaction process determined by a measuring process such as percentage yield calculated via the mass measured."@en ;
                                                     <https://cwrusdle.bitbucket.io/mds/hasDomain> "Chem"@en ;
                                                     <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Analysis" ,
                                                                                                       "Result" ;
                                                     <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "Chem-Rxn"@en .


###  https://cwrusdle.bitbucket.io/mds/AnalyticalTechnique
<https://cwrusdle.bitbucket.io/mds/AnalyticalTechnique> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ActOfCharacterizing> ;
                                                        rdfs:label "AnalyticalTechnique"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#altLabel> " " ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "An analytical technique is an act of measuring the qualitative or quantitative attributes of a chemical compound. This is done in Analytical Chemistry which is a discipline that develops and applies strategies, instruments, and procedures to obtain information on the composition and nature of matter in space and time. [IUPAC]"@en ;
                                                        <https://cwrusdle.bitbucket.io/mds/hasDomain> "Chem"@en ;
                                                        <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Analysis" ;
                                                        <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "Chem-Rxn"@en ;
                                                        <https://www.commoncoreontologies.org/ont00001754> "https://doi.org/10.1351/goldbook.08003"@en .


