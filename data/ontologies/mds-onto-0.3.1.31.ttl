                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
                                                   rdfs:label "Damaging Artifact Function"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "An Artifact Function that is realized in a process in which the structural integrity of an entity is impaired."@en ;
