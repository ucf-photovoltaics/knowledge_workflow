                                               rdfs:domain <https://cwrusdle.bitbucket.io/mds/Sensor> ;
                                               rdfs:range <https://cwrusdle.bitbucket.io/mds/InstrumentType> .


###  https://cwrusdle.bitbucket.io/mds/ThermalProperty
<https://cwrusdle.bitbucket.io/mds/ThermalProperty> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <https://cwrusdle.bitbucket.io/mds/ThermalProperty> ;
                                                    rdfs:range [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <https://cwrusdle.bitbucket.io/mds/BoilingTemperature>
                                                                               <https://cwrusdle.bitbucket.io/mds/GlassTransitionTemperature>
                                                                               <https://cwrusdle.bitbucket.io/mds/HeatCapacity>
                                                                               <https://cwrusdle.bitbucket.io/mds/HeatOfFormation>
                                                                               <https://cwrusdle.bitbucket.io/mds/HeatofCombustion>
                                                                               <https://cwrusdle.bitbucket.io/mds/MeltTemperature>
                                                                               <https://cwrusdle.bitbucket.io/mds/PhaseTransitionTemperature>
                                                                               <https://cwrusdle.bitbucket.io/mds/SpecificHeat>
                                                                             )
                                                               ] .


