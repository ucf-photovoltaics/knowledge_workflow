###  http://purl.obolibrary.org/obo/CHMO_0000113
<http://purl.obolibrary.org/obo/CHMO_0000113> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHMO_0000112> ;
                                              rdfs:label "atomic force microscopy" ;
                                              <http://www.w3.org/2004/02/skos/core#altLabel> "AFM" ,
                                                                                             "SFM" ,
                                                                                             "atomic force imaging" ,
                                                                                             "scanning force microscopy" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Microscopy which uses a sharp spike (known as a 'tip') mounted on the end of a cantilever to scan the surface of the specimen. An image of the surface is obtained by mechanically moving the probe in a raster scan of the specimen, line by line, and recording the force experienced by the tip as a function of position. A feedback loop is used to maintain a fixed relationship between the tip and surface during scanning.[CHMO]" ;
                                              <https://cwrusdle.bitbucket.io/mds/hasDomain> "Charact" ;
                                              <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Analysis" ;
                                              <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "Material-AFM" .


