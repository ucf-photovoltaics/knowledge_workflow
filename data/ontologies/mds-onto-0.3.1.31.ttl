###  https://www.commoncoreontologies.org/ont00000633
<https://www.commoncoreontologies.org/ont00000633> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                   rdfs:comment "When an object is \"weighed\", in the typical case, it is done so by taking into account the local force of gravity to determine the object's mass, whose standard of measure is the kilogram. The actual unit of measure of weight is the newton."@en ;
                                                   rdfs:label "Weight"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Quality that inheres in some material entity with a mass in virtue of its location in some gravitational field."@en ;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <https://www.commoncoreontologies.org/ont00000633> ;
                                                   <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Sample" ;
                                                   <https://www.commoncoreontologies.org/ont00001760> "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI .


