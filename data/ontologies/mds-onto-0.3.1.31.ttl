###  https://cwrusdle.bitbucket.io/mds/SolvothermalProcessing
<https://cwrusdle.bitbucket.io/mds/SolvothermalProcessing> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/MaterialsProcessing> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                             owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/GrowthTime>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                             owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/ReactionPressure>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                             owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/ReactionTemperature>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                             owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/Solvent>
                                                                           ] ;
                                                           rdfs:label "Solvothermal Processing"@en ;
                                                           <http://www.w3.org/2004/02/skos/core#altLabel> "Hydrothermal Processing" ,
                                                                                                          "Solvothermal Synthesis" ;
                                                           <http://www.w3.org/2004/02/skos/core#definition> "A synthesis method that uses a solvent under elevated temperature and pressure to facilitate chemical reactions and crystal growth."@en ;
                                                           <https://cwrusdle.bitbucket.io/mds/hasDomain> "Manufacture"@en ;
                                                           <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Materials Processing" ;
                                                           <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "MatProc"@en .


