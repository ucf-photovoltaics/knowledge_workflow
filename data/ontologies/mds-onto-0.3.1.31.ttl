###  https://cwrusdle.bitbucket.io/mds/CzochralskiMethod
<https://cwrusdle.bitbucket.io/mds/CzochralskiMethod> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/MaterialsProcessing> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                        owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/GrowthTime>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                        owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/PullRate>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                        owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/RotationSpeed>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                        owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/SolventFlux>
                                                                      ] ;
                                                      rdfs:label "Czochralski Method"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#altLabel> "CZ Method" ,
                                                                                                     "Crystal Pulling" ,
                                                                                                     "Czochralski Process" ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "A method of crystal growth used to obtain single crystals by slowly pulling a seed crystal from a melt while rotating it."@en ;
                                                      <https://cwrusdle.bitbucket.io/mds/hasDomain> "Manufacture"@en ;
                                                      <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Materials Processing" ;
                                                      <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "MatProc"@en .


