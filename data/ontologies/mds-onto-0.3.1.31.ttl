###  https://cwrusdle.bitbucket.io/mds/Annealing
<https://cwrusdle.bitbucket.io/mds/Annealing> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/MaterialsProcessing> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/CoolingRate>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/DwellTime>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/HeatingRate>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://cwrusdle.bitbucket.io/mds/hasProcessingParameter> ;
                                                                owl:someValuesFrom <https://cwrusdle.bitbucket.io/mds/ProcessingTemperature>
                                                              ] ;
                                              <http://purl.org/dc/terms/source> "ISO 4885:2018" ;
                                              rdfs:label "Annealing"@en ;
                                              <http://www.w3.org/2004/02/skos/core#altLabel> "Heat Annealing" ,
                                                                                             "Thermal Annealing" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A heat treatment process that involves heating a material to a specific temperature, holding it at that temperature, and then cooling it at a controlled rate to alter its physical and sometimes chemical properties, typically to reduce hardness, improve ductility, and relieve internal stresses."@en ;
                                              <https://cwrusdle.bitbucket.io/mds/hasDomain> "Manufacture"@en ;
                                              <https://cwrusdle.bitbucket.io/mds/hasStudyStage> "Materials Processing" ;
                                              <https://cwrusdle.bitbucket.io/mds/hasSubDomain> "MatProc"@en .


