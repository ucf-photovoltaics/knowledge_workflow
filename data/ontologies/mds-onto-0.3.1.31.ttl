                                             rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Recipe> ;
                                             rdfs:label "Exposure" ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> " " ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "An exposure is a process under which samples (i.e. study objects) are tested under environmental stressors." ;
