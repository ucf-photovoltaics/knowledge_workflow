@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix bfo:   <http://purl.obolibrary.org/obo/BFO_> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix mds:   <https://cwrusdle.bitbucket.io/mds#> .
@prefix mds-pv: <https://cwrusdle.bitbucket.io/mds-pv-cell#> .
@prefix :      <https://cwrusdle.bitbucket.io/gaas-pv-example#> .
 
# ============================================================
# Ontology Declaration
# ============================================================
 
<https://cwrusdle.bitbucket.io/gaas-pv-example>
    a owl:Ontology ;
    owl:versionIRI <https://cwrusdle.bitbucket.io/gaas-pv-example/0.1.0> ;
    rdfs:label "GaAs PV Cell Example Ontology"^^xsd:string ;
    dcterms:title "GaAs Photovoltaic Cell Domain Ontology (MDS-Onto Compliant)"^^xsd:string ;
    dcterms:description "An MDS-Onto compliant ontology for GaAs-based photovoltaic cell research data, covering absorber layer properties, processing, and device performance."^^xsd:string ;
    dcterms:created "2026-06-03"^^xsd:date ;
    owl:imports mds: ;
    owl:versionInfo "0.1.0"^^xsd:string .
 
# ============================================================
# Class Definitions  (extend mds: top-level concepts)
# ============================================================
 
# --- Publication / Study ---
 
:Publication
    a owl:Class ;
    rdfs:subClassOf pmd:InformationContentEntity ;
    rdfs:label "Publication"^^xsd:string ;
    skos:definition "A scientific publication reporting PV cell fabrication and characterization results."^^xsd:string ;
    skos:altLabel "Paper"^^xsd:string , "Article"^^xsd:string .
 
# --- Device ---
 
:PVCell
    a owl:Class ;
    rdfs:subClassOf mds:Tool ;
    rdfs:label "PV Cell"^^xsd:string ;
    skos:definition "A photovoltaic cell that converts light into electricity; the smallest unit of a PV site."^^xsd:string ;
    skos:altLabel "Photovoltaic Cell"^^xsd:string , "Solar Cell"^^xsd:string .
 
# --- Absorber Layer ---
 
:AbsorberLayer
    a owl:Class ;
    rdfs:subClassOf pmd:Material ;
    rdfs:label "Absorber Layer"^^xsd:string ;
    skos:definition "The semiconductor layer responsible for absorbing photons and generating electron-hole pairs."^^xsd:string ;
    skos:altLabel "Absorber"^^xsd:string , "Active Layer"^^xsd:string .
 
# --- Dopant ---
 
:Dopant
    a owl:Class ;
    rdfs:subClassOf pmd:Material ;
    rdfs:label "Dopant"^^xsd:string ;
    skos:definition "An impurity species introduced into the absorber to control its electrical conductivity type and carrier concentration."^^xsd:string .
 
# --- Processing Route ---
 
:ProcessingRoute
    a owl:Class ;
    rdfs:subClassOf mds:Recipe ;
    rdfs:label "Processing Route"^^xsd:string ;
    skos:definition "The ordered sequence of fabrication steps used to manufacture the PV cell."^^xsd:string ;
    skos:altLabel "Fabrication Process"^^xsd:string , "Process Flow"^^xsd:string .
 
# --- Measurement Conditions ---
 
:MeasurementCondition
    a owl:Class ;
    rdfs:subClassOf pmd:Process ;
    rdfs:label "Measurement Condition"^^xsd:string ;
    skos:definition "The conditions under which electrical characterisation of the PV cell was performed."^^xsd:string ;
    skos:altLabel "Test Conditions"^^xsd:string .
 
# --- Performance Metrics ---
 
:ElectricalPerformance
    a owl:Class ;
    rdfs:subClassOf pmd:ValueObject ;
    rdfs:label "Electrical Performance"^^xsd:string ;
    skos:definition "The set of key figures-of-merit describing the power conversion performance of a PV cell."^^xsd:string .
 
# ============================================================
# Object Properties
# ============================================================
 
:isReportedIn
    a owl:ObjectProperty ;
    rdfs:domain :PVCell ;
    rdfs:range :Publication ;
    rdfs:label "is reported in"^^xsd:string ;
    skos:definition "Links a PV cell device to the publication in which its fabrication and performance are reported."^^xsd:string .
 
:hasAbsorberLayer
    a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:hasConstituent ;
    rdfs:domain :PVCell ;
    rdfs:range :AbsorberLayer ;
    rdfs:label "has absorber layer"^^xsd:string ;
    skos:definition "A PV cell has-a absorber layer as a constituent part."^^xsd:string .
 
:hasDopant
    a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:hasConstituent ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range :Dopant ;
    rdfs:label "has dopant"^^xsd:string ;
    skos:definition "An absorber layer has-a dopant species."^^xsd:string .
 
:hasProcessingRoute
    a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:hasProcess ;
    rdfs:domain :PVCell ;
    rdfs:range :ProcessingRoute ;
    rdfs:label "has processing route"^^xsd:string ;
    skos:definition "A PV cell has-a processing route describing its manufacture."^^xsd:string .
 
:hasMeasurementCondition
    a owl:ObjectProperty ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range :MeasurementCondition ;
    rdfs:label "has measurement condition"^^xsd:string .
 
:hasElectricalPerformance
    a owl:ObjectProperty ;
    rdfs:subPropertyOf pmd:hasProperty ;
    rdfs:domain :PVCell ;
    rdfs:range :ElectricalPerformance ;
    rdfs:label "has electrical performance"^^xsd:string ;
    skos:definition "A PV cell has-a set of electrical performance characteristics."^^xsd:string .
 
# ============================================================
# Data Properties – Absorber
# ============================================================
 
:absorberMaterialComposition
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasIdentifier ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber material composition"^^xsd:string ;
    skos:altLabel "material"^^xsd:string , "composition"^^xsd:string ;
    qudt:hasUnit unit:UNITLESS .
 
:absorberCrystallinity
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber crystallinity"^^xsd:string ;
    skos:altLabel "crystal structure"^^xsd:string , "grain structure"^^xsd:string .
 
:absorberBandgapType
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber bandgap type"^^xsd:string ;
    skos:altLabel "bandgap nature"^^xsd:string .
 
:absorberBandgapValue
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:decimal ;
    rdfs:label "absorber bandgap value"^^xsd:string ;
    skos:altLabel "Eg"^^xsd:string , "bandgap energy"^^xsd:string ;
    qudt:hasUnit unit:EV .
 
:absorberDopantPolarity
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber dopant polarity"^^xsd:string ;
    skos:altLabel "doping type"^^xsd:string , "conductivity type"^^xsd:string .
 
:absorberDopantConcentration
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber dopant concentration"^^xsd:string ;
    skos:altLabel "carrier concentration"^^xsd:string , "doping level"^^xsd:string ;
    qudt:hasUnit unit:PER-CentiM3 .
 
:absorberBulkResistivity
    a owl:DatatypeProperty ;
    rdfs:domain :AbsorberLayer ;
    rdfs:range xsd:string ;
    rdfs:label "absorber bulk resistivity"^^xsd:string ;
    skos:altLabel "resistivity"^^xsd:string .
 
# --- Dopant Data Properties ---
 
:dopantSpecies
    a owl:DatatypeProperty ;
    rdfs:domain :Dopant ;
    rdfs:range xsd:string ;
    rdfs:label "dopant species"^^xsd:string ;
    skos:altLabel "dopant element"^^xsd:string .
 
# ============================================================
# Data Properties – Device
# ============================================================
 
:deviceType
    a owl:DatatypeProperty ;
    rdfs:domain :PVCell ;
    rdfs:range xsd:string ;
    rdfs:label "device type"^^xsd:string ;
    skos:altLabel "cell architecture"^^xsd:string .
 
:cellArea
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :PVCell ;
    rdfs:range xsd:decimal ;
    rdfs:label "photovoltaic cell area"^^xsd:string ;
    skos:altLabel "active area"^^xsd:string , "device area"^^xsd:string ;
    qudt:hasUnit unit:CentiM2 .
 
# ============================================================
# Data Properties – Processing Route
# ============================================================
 
:absorberPrimaryDepositionMethod
    a owl:DatatypeProperty ;
    rdfs:domain :ProcessingRoute ;
    rdfs:range xsd:string ;
    rdfs:label "absorber primary deposition method"^^xsd:string ;
    skos:altLabel "absorber growth technique"^^xsd:string , "deposition method"^^xsd:string .
 
:sequentialProcessingSteps
    a owl:DatatypeProperty ;
    rdfs:domain :ProcessingRoute ;
    rdfs:range xsd:string ;
    rdfs:label "sequential list of all processing steps"^^xsd:string ;
    skos:altLabel "process sequence"^^xsd:string , "fabrication steps"^^xsd:string .
 
# ============================================================
# Data Properties – Measurement Condition
# ============================================================
 
:standardTestConditionsUsed
    a owl:DatatypeProperty ;
    rdfs:domain :MeasurementCondition ;
    rdfs:range xsd:boolean ;
    rdfs:label "standard test conditions used"^^xsd:string ;
    skos:altLabel "STC"^^xsd:string , "AM1.5G"^^xsd:string .
 
# ============================================================
# Data Properties – Electrical Performance
# ============================================================
 
:powerConversionEfficiency
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "power conversion efficiency"^^xsd:string ;
    skos:altLabel "PCE"^^xsd:string , "efficiency"^^xsd:string , "eta"^^xsd:string ;
    qudt:hasUnit unit:PERCENT .
 
:shortCircuitCurrent
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "short-circuit current"^^xsd:string ;
    skos:altLabel "Isc"^^xsd:string ;
    qudt:hasUnit unit:A .
 
:shortCircuitCurrentDensity
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "short-circuit current density"^^xsd:string ;
    skos:altLabel "Jsc"^^xsd:string ;
    qudt:hasUnit unit:MilliA-PER-CentiM2 .
 
:openCircuitVoltage
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "open-circuit voltage"^^xsd:string ;
    skos:altLabel "Voc"^^xsd:string ;
    qudt:hasUnit unit:V .
 
:fillFactor
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasValue ;
    rdfs:domain :ElectricalPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "fill factor"^^xsd:string ;
    skos:altLabel "FF"^^xsd:string ;
    qudt:hasUnit unit:PERCENT .
 
# ============================================================
# Data Properties – Publication
# ============================================================
 
:doi
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf pmd:hasIdentifier ;
    rdfs:domain :Publication ;
    rdfs:range xsd:anyURI ;
    rdfs:label "DOI"^^xsd:string ;
    skos:altLabel "digital object identifier"^^xsd:string .
 
:keyTakeaways
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:label "key takeaways"^^xsd:string ;
    skos:altLabel "main findings"^^xsd:string , "summary"^^xsd:string .
 
:numberOfFigures
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:integer ;
    rdfs:label "number of figures"^^xsd:string .
 
:descriptiveListOfFigures
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:label "descriptive list of figures"^^xsd:string .
 
:numberOfEquations
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:integer ;
    rdfs:label "number of equations"^^xsd:string .
 
:equations
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:label "equations"^^xsd:string .
 
:numberOfTables
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:integer ;
    rdfs:label "number of tables"^^xsd:string .
 
:descriptiveListOfTables
    a owl:DatatypeProperty ;
    rdfs:domain :Publication ;
    rdfs:range xsd:string ;
    rdfs:label "descriptive list of tables"^^xsd:string .
 
# ============================================================
# Named Individuals – Row 1  (no DOI; Hovel et al. polycrystalline GaAs)
# ============================================================
 
:Study_01
    a :Publication ;
    rdfs:label "Study 01 – Polycrystalline GaAs surface-barrier cells"^^xsd:string ;
    :keyTakeaways "Thin-film solar cells utilizing polycrystalline GaAs films were fabricated on molybdenum and aluminum substrates. Surface barrier junctions using platinum or copper selenide yielded the highest efficiencies, up to 5% for a 0.2 cm² area. Degradation of the devices over time was mitigated by appropriate etching treatments."^^xsd:string ;
    :numberOfFigures 9 ;
    :descriptiveListOfFigures "(1) absorption coefficients of GaAs films, (2) forward current voltage characteristics of Pt-GaAs cells, (3) optical absorption spectra of typical Cu1.8Se film flash evaporated on glass, (4) surface barrier cell structures on Mo and Al substrates, (5) spectral response of Pt and Cu1.8Se barrier cells, (6) efficiency measurement of Cu1.8Se-GaAs on Al foil, (7) efficiency measurement of Pt-GaAs cells, (8) power output vs. time for Pt-GaAs cells, (9) room ambient life tests for Cu1.8Se-GaAs cells"^^xsd:string ;
    :numberOfEquations 1 ;
    :equations "I = I_0 (exp(qV/aKT) - 1)"^^xsd:string ;
    :numberOfTables 0 .
 
:Absorber_01
    a :AbsorberLayer ;
    rdfs:label "Absorber Layer – Study 01"^^xsd:string ;
    :absorberMaterialComposition "GaAs"^^xsd:string ;
    :absorberCrystallinity "polycrystalline"^^xsd:string ;
    :absorberBandgapType "not specified"^^xsd:string ;
    :absorberBandgapValue "1.4"^^xsd:decimal ;
    :absorberDopantPolarity "n-type"^^xsd:string ;
    :absorberDopantConcentration "1e15-1e16"^^xsd:string ;
    :absorberBulkResistivity "not specified"^^xsd:string ;
    :hasDopant :Dopant_01 .
 
:Dopant_01
    a :Dopant ;
    rdfs:label "Dopant – Study 01 (Sn, Ge)"^^xsd:string ;
    :dopantSpecies "Sn, Ge"^^xsd:string .
 
:Process_01
    a :ProcessingRoute ;
    rdfs:label "Processing Route – Study 01"^^xsd:string ;
    :absorberPrimaryDepositionMethod "vapor growth"^^xsd:string ;
    :sequentialProcessingSteps "(1) pre-coating molybdenum or aluminum foil substrate with tin-germanium alloy or InAs, (2) vapor deposition of polycrystalline GaAs film, (3) etching GaAs film, (4) evaporation or flash evaporation of platinum or copper selenide barrier layer, (5) post-evaporation etching, (6) evaporation of gold grid, (7) application of Krylon or SiO anti-reflection coating"^^xsd:string .
 
:MeasCond_01
    a :MeasurementCondition ;
    rdfs:label "Measurement Condition – Study 01"^^xsd:string ;
    :standardTestConditionsUsed false .
 
:Performance_01
    a :ElectricalPerformance ;
    rdfs:label "Electrical Performance – Study 01"^^xsd:string ;
    :powerConversionEfficiency "5"^^xsd:decimal ;
    :shortCircuitCurrentDensity "15"^^xsd:decimal ;
    :openCircuitVoltage "0.6"^^xsd:decimal ;
    :hasMeasurementCondition :MeasCond_01 .
 
:PVCell_01
    a :PVCell ;
    rdfs:label "GaAs PV Cell – Study 01"^^xsd:string ;
    :deviceType "photovoltaic cell"^^xsd:string ;
    :cellArea "0.2"^^xsd:decimal ;
    :hasAbsorberLayer :Absorber_01 ;
    :hasProcessingRoute :Process_01 ;
    :hasElectricalPerformance :Performance_01 ;
    :isReportedIn :Study_01 .
 
# ============================================================
# Named Individuals – Row 2  (DOI: 10.3390/app12020820)
# ============================================================
 
:Study_02
    a :Publication ;
    rdfs:label "Study 02 – GaAs on Si substrate via MBE and ELO"^^xsd:string ;
    :doi <https://doi.org/10.3390/app12020820> ;
    :keyTakeaways "Thin-film GaAs solar cells were epitaxially grown on a Si substrate and successfully transferred to a polyimide film using metal wafer bonding and epitaxial lift-off. A threading dislocation density of 1.8e7 cm^-2 was achieved by employing an InGaAs insertion layer and thermal cycle annealing. The resulting inverted GaAs solar cell demonstrated a 10.6% 1-Sun efficiency without an anti-reflection coating."^^xsd:string ;
    :numberOfFigures 5 ;
    :descriptiveListOfFigures "(1) GaAs buffer structure on Si and ECCI image showing threading dislocation density, (2) schematic illustration of GaAs solar cell grown on Si and microscopy images, (3) photograph of 2-inch GaAs cell on Si with micro-PL mapping and Raman spectra, (4) fabrication procedure for transfer process and photograph of transferred cell, (5) schematic diagrams of the one-junction GaAs solar cells with dark current and illuminated J-V characteristics"^^xsd:string ;
    :numberOfEquations 0 ;
    :numberOfTables 0 .
 
:Absorber_02
    a :AbsorberLayer ;
    rdfs:label "Absorber Layer – Study 02"^^xsd:string ;
    :absorberMaterialComposition "GaAs"^^xsd:string ;
    :absorberCrystallinity "single crystal"^^xsd:string ;
    :absorberBandgapType "not specified"^^xsd:string ;
    :absorberDopantPolarity "n-type"^^xsd:string ;
    :absorberDopantConcentration "1e17"^^xsd:string ;
    :absorberBulkResistivity "not specified"^^xsd:string .
 
:Process_02
    a :ProcessingRoute ;
    rdfs:label "Processing Route – Study 02"^^xsd:string ;
    :absorberPrimaryDepositionMethod "molecular beam epitaxy"^^xsd:string ;
    :sequentialProcessingSteps "(1) growth of GaAs buffer and inverted solar cell structure on Si substrate using molecular beam epitaxy, (2) deposition of Pt/Au bonding material and ohmic contact metal on GaAs sample and transfer substrate, (3) definition of mesas by photolithography, (4) etching of samples using phosphoric acid, hydrogen peroxide, and deionized water, (5) surface activation via Ar plasma irradiation, (6) metal wafer bonding under uniaxial pressure, (7) epitaxial lift-off using HF-based solution to etch AlAs sacrificial layer, (8) deposition of Pt/Ti/Pt/Au top contact layers by electron beam evaporation"^^xsd:string .
 
:MeasCond_02
    a :MeasurementCondition ;
    rdfs:label "Measurement Condition – Study 02"^^xsd:string ;
    :standardTestConditionsUsed true .
 
:Performance_02
    a :ElectricalPerformance ;
    rdfs:label "Electrical Performance – Study 02"^^xsd:string ;
    :powerConversionEfficiency "11.2"^^xsd:decimal ;
    :shortCircuitCurrentDensity "19.3"^^xsd:decimal ;
    :openCircuitVoltage "0.92"^^xsd:decimal ;
    :fillFactor "82.6"^^xsd:decimal ;
    :hasMeasurementCondition :MeasCond_02 .
 
:PVCell_02
    a :PVCell ;
    rdfs:label "GaAs PV Cell – Study 02"^^xsd:string ;
    :deviceType "photovoltaic cell"^^xsd:string ;
    :cellArea "0.09"^^xsd:decimal ;
    :hasAbsorberLayer :Absorber_02 ;
    :hasProcessingRoute :Process_02 ;
    :hasElectricalPerformance :Performance_02 ;
    :isReportedIn :Study_02 .
 
# ============================================================
# Named Individuals – Row 3  (DOI: 10.1143/JJAP.44.L985)
# ============================================================
 
:Study_03
    a :Publication ;
    rdfs:label "Study 03 – Large-area GaAs and GaInAs cells via MOVPE"^^xsd:string ;
    :doi <https://doi.org/10.1143/JJAP.44.L985> ;
    :keyTakeaways "Large-area 5x5 cm² GaAs and GaInAs single-junction solar cells were successfully fabricated with efficiencies matching those of 1x1 cm² cells due to excellent epitaxial uniformity. The GaAs cell achieved a record conversion efficiency of 26.0% under AM1.5G conditions by optimizing the antireflection coating. The combined characteristics suggest a potential efficiency exceeding 30% for a mechanically stacked GaAs/GaInAs tandem cell."^^xsd:string ;
    :numberOfFigures 3 ;
    :descriptiveListOfFigures "(1) structures of GaAs and GaInAs single-junction cells for mechanical stacking, (2) spectral responses of GaAs single-junction cells with different AR coatings, (3) current-voltage characteristics of a GaAs single-junction cell with an optimized AR coating"^^xsd:string ;
    :numberOfEquations 0 ;
    :numberOfTables 3 ;
    :descriptiveListOfTables "(1) characteristics of GaAs single-junction cells for mechanical stacking, (2) characteristics of GaInAs single-junction cell without and under GaAs top cell, (3) characteristics of GaAs single-junction cells with different back-surface contact patterns"^^xsd:string .
 
:Absorber_03_GaAs
    a :AbsorberLayer ;
    rdfs:label "Absorber Layer – Study 03 (GaAs)"^^xsd:string ;
    :absorberMaterialComposition "GaAs"^^xsd:string ;
    :absorberCrystallinity "single crystal"^^xsd:string ;
    :absorberBandgapValue "1.42"^^xsd:decimal ;
    :absorberBulkResistivity "not specified"^^xsd:string ;
    :hasDopant :Dopant_03_Si .
 
:Absorber_03_GaInAs
    a :AbsorberLayer ;
    rdfs:label "Absorber Layer – Study 03 (GaInAs)"^^xsd:string ;
    :absorberMaterialComposition "GaInAs"^^xsd:string ;
    :absorberCrystallinity "single crystal"^^xsd:string ;
    :absorberBandgapValue "0.75"^^xsd:decimal ;
    :absorberBulkResistivity "not specified"^^xsd:string ;
    :hasDopant :Dopant_03_Zn .
 
:Dopant_03_Si
    a :Dopant ;
    rdfs:label "Dopant – Study 03 (Si)"^^xsd:string ;
    :dopantSpecies "Si"^^xsd:string .
 
:Dopant_03_Zn
    a :Dopant ;
    rdfs:label "Dopant – Study 03 (Zn)"^^xsd:string ;
    :dopantSpecies "Zn"^^xsd:string .
 
:Process_03
    a :ProcessingRoute ;
    rdfs:label "Processing Route – Study 03"^^xsd:string ;
    :absorberPrimaryDepositionMethod "low-pressure metalorganic vapor phase epitaxy"^^xsd:string ;
    :sequentialProcessingSteps "(1) epitaxial growth of cell structures on GaAs and InP substrates using low-pressure MOVPE, (2) deposition of electrolytic plating of gold for grid electrodes on the front surface, (3) application of MgF2/ZnS double-layer antireflection coatings"^^xsd:string .
 
:MeasCond_03
    a :MeasurementCondition ;
    rdfs:label "Measurement Condition – Study 03"^^xsd:string ;
    :standardTestConditionsUsed true .
 
:Performance_03
    a :ElectricalPerformance ;
    rdfs:label "Electrical Performance – Study 03"^^xsd:string ;
    :powerConversionEfficiency "26"^^xsd:decimal ;
    :shortCircuitCurrent "0.6924"^^xsd:decimal ;
    :shortCircuitCurrentDensity "28.82"^^xsd:decimal ;
    :openCircuitVoltage "1.07"^^xsd:decimal ;
    :fillFactor "85.7"^^xsd:decimal ;
    :hasMeasurementCondition :MeasCond_03 .
 
:PVCell_03
    a :PVCell ;
    rdfs:label "GaAs PV Cell – Study 03"^^xsd:string ;
    :deviceType "photovoltaic cell"^^xsd:string ;
    :cellArea "24.39"^^xsd:decimal ;
    :hasAbsorberLayer :Absorber_03_GaAs ;
    :hasAbsorberLayer :Absorber_03_GaInAs ;
    :hasProcessingRoute :Process_03 ;
    :hasElectricalPerformance :Performance_03 ;
    :isReportedIn :Study_03 .
 
# ============================================================
# Named Individuals – Row 4  (DOI: 10.1063/1.4878156)
# ============================================================
 
:Study_04
    a :Publication ;
    rdfs:label "Study 04 – Ultra-thin 300 nm GaAs single-junction cell"^^xsd:string ;
    :doi <https://doi.org/10.1063/1.4878156> ;
    :keyTakeaways "Ultra-thin GaAs single-junction solar cells were designed and demonstrated with a 300 nm absorber and an integrated AlInP reflective back scattering layer. Devices fabricated via a substrate-removal and flip-chip bonding process achieved an efficiency of 19.1% with a 9.7% contact coverage. Semi-analytical modeling confirms this architecture enables light trapping and minimizes non-radiative recombination, providing a pathway to high efficiencies."^^xsd:string ;
    :numberOfFigures 9 ;
    :descriptiveListOfFigures "(1) schematic layer structure of the finished solar cell and as-grown wafers, (2) simulated power conversion efficiency and reflectance contour, (3) cross-section and top-view SEM and microscopic images of as-grown AlInP surfaces, (4) schematic flow of the device growth and fabrication processes, (5) measured reflectance of the MgF2/ZnS AR coating on a calibration wafer, (6) current-voltage curves of TLM contacts, (7) optical micrograph of fabricated solar cells, (8) measured room-temperature I-V characteristics of the GaAs solar cells, (9) external quantum efficiency as a function of wavelength for the GaAs solar cell"^^xsd:string ;
    :numberOfEquations 1 ;
    :equations "R_total = integral(280nm to 870nm) R(lambda) * N_sun(lambda) dlambda / integral(280nm to 870nm) N_sun(lambda) dlambda"^^xsd:string ;
    :numberOfTables 1 ;
    :descriptiveListOfTables "(1) comparison between the measured and modeled best achievable device performance of 300 nm GaAs single-junction solar cell"^^xsd:string .
 
:Absorber_04
    a :AbsorberLayer ;
    rdfs:label "Absorber Layer – Study 04"^^xsd:string ;
    :absorberMaterialComposition "GaAs"^^xsd:string ;
    :absorberCrystallinity "single crystal"^^xsd:string ;
