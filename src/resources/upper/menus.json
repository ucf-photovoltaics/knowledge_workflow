  "local_properties": {
    "influences": {
      "parent": null,
      "definition": "x influences y: the paper corpus reports that a change in x brings about a change in y.",
      "close_match": "CCO:affects",
      "subproperty_of": "RO:causally related to"
    },
    "increases": {
      "parent": "influences",
      "definition": "x increases y: an increase or presence of x is reported to raise y.",
      "close_match": "CCO:affects"
    },
    "decreases": {
      "parent": "influences",
      "definition": "x decreases y: an increase or presence of x is reported to lower y.",
      "close_match": "CCO:affects"
    },
    "causes": {
      "parent": "influences",
      "definition": "x causes y: x is reported to bring about y.",
      "close_match": "CCO:is cause of"
    },
    "enables": {
      "parent": "influences",
      "definition": "x enables y: x is reported as a precondition for y.",
      "close_match": "CCO:affects"
    },
    "prevents": {
      "parent": "influences",
      "definition": "x prevents y: x is reported to stop or suppress y.",
      "close_match": "CCO:inhibits"
    }
  },
  "causal_polarity": {
    "increases": "increases",
    "decreases": "decreases",
    "causes": "causes",
    "enables": "enables",
    "prevents": "prevents",
    "affects": "influences"
  },
  "type_defaults": {
    "material": "material entity",
    "device": "Material Artifact",
    "equipment": "Material Artifact",
    "process": "process",
    "phenomenon": "process",
    "property": "quality",
    "quantity": "quality",
    "method": "Plan",
    "defect": "material entity",
    "condition": "quality",
    "information": "Information Content Entity",
    "parameter": "process profile"
  },
  "causal_rules": [
    {
      "cause": "process",
      "effect": "process",
      "map": {
        "increases": "RO:causally upstream of, positive effect",
        "decreases": "RO:causally upstream of, negative effect",
        "prevents": "RO:causally upstream of, negative effect",
        "*": "RO:causally upstream of"
      }
    },
    {
      "cause": "process",
      "effect": "specifically dependent continuant",
      "map": {
        "increases": "RO:positively regulates characteristic",
        "decreases": "RO:negatively regulates characteristic",
        "prevents": "RO:negatively regulates characteristic",
        "*": "RO:regulates characteristic"
      }
    },
    {
      "cause": "continuant",
      "effect": "continuant",
      "map": {
        "*": "RO:causally influences"
      }
    },
    {
      "cause": "process",
      "effect": "process",
      "map": {
        "causes": "CCO:is cause of",
        "prevents": "CCO:inhibits"
      }
    },
    {
      "cause": "process",
      "effect": "entity",
      "map": {
        "*": "CCO:affects"
      }
    }
  ],
  "causal_fallback": "RO:causally related to",
  "_notes": {
    "properties": "SOURCE:label. BFO = BFO 2020 core, CCO = Common Core Ontologies, RO = OBO Relations Ontology. Shown side by side to the enrichment agent.",
    "causal_rules": "Every causal edge keeps its local polarity property and also gets, per source, the first rule whose cause/effect BFO category and the property's domain/range fit. causal_fallback (RO) is used when no RO rule fits."
  }
}