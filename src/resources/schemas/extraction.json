{
  "type": "object",
  "required": ["concepts", "relations", "causal", "measurements", "figures"],
  "properties": {
    "concepts": {"type": "array", "items": {"type": "object", "required": ["id", "label", "type"], "properties": {
      "id": {"type": "string", "description": "c1, c2, ..."},
      "label": {"type": "string"},
      "type": {"enum": ["material", "device", "equipment", "process", "parameter", "phenomenon", "property", "quantity", "method", "defect", "condition", "information"]},
      "definition": {"type": "string"},
      "synonyms": {"type": "array", "items": {"type": "string"}},
      "figures": {"type": "array", "items": {"type": "string", "description": "F<n>"}}}}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["s", "p", "o"], "properties": {
      "s": {"type": "string"},
      "p": {"enum": ["is_a", "part_of", "has_part", "made_of", "has_property", "measured_by", "input_of", "output_of", "precedes", "participates_in", "located_in", "used_for", "related_to"]},
      "o": {"type": "string"},
      "evidence": {"type": "string"}}}},
    "causal": {"type": "array", "items": {"type": "object", "required": ["cause", "effect", "polarity"], "properties": {
      "cause": {"type": "string"},
      "effect": {"type": "string"},
      "polarity": {"enum": ["increases", "decreases", "causes", "enables", "prevents", "affects"]},
      "condition": {"type": "string"},
      "evidence": {"type": "string"}}}},
    "measurements": {"type": "array", "items": {"type": "object", "required": ["concept", "value"], "properties": {
      "concept": {"type": "string", "description": "concept id of the property or parameter"},
      "value": {"type": "string"},
      "unit": {"type": "string"},
      "condition": {"type": "string", "description": "sample, device or condition it applies to"},
      "evidence": {"type": "string"}}}},
    "figures": {"type": "array", "items": {"type": "object", "required": ["id", "concepts"], "properties": {
      "id": {"type": "string"},
      "concepts": {"type": "array", "items": {"type": "string"}},
      "shows": {"type": "string"}}}}
  }
}
