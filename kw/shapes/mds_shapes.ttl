@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/> .

# SHACL shapes for the Kweave-generated ontology (T1.3).
# Minimal, conservative constraints — extend as your modelling tightens.

# Every owl:Class must carry an rdfs:label.
mds:ClassShape
    a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every class must have an rdfs:label." ;
    ] .

# Every datatype property must have a label and a skos:broader MDS branch.
mds:ConceptPropertyShape
    a sh:NodeShape ;
    sh:targetClass owl:DatatypeProperty ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every concept property must have an rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:broader ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every concept property must link to an MDS branch via skos:broader." ;
    ] .
