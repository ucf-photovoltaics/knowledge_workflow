        kw:StepSpecification ;
    rdfs:label "Extract evidence-backed paper records" ;
    rdfs:comment "One reconciled record per paper: concepts, relations, causal claims, measurements, quotes, figures and verification. CLI extract combines ingestion, parsing and extraction; do not invoke it separately for the first two UI steps." ;
