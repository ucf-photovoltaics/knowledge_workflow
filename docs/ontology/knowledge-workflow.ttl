<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/ontology> a owl:NamedIndividual,
        kw:StepSpecification ;
    rdfs:label "Place canonical concepts" ;
    rdfs:comment "Place under BFO/CCO or suitable existing/corpus parents, assign stable domain IRIs, check cycles/categories. Distinguish excluded concepts, default parents and review flags from reviewed placements." ;
    skos:definition "Place under BFO/CCO or suitable existing/corpus parents, assign stable domain IRIs, check cycles/categories. Distinguish excluded concepts, default parents and review flags from reviewed placements."@en ;
    skos:scopeNote "Fallback placement, exclusions and review flags require domain review."@en ;
    kw:artifactLocations "[\".\"]" ;
    kw:canAdvanceTo <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/enrich> ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Collect canonical relations and evidence context for placement choices.\", \"function\": \"src/tools/ontology_review.py:context\", \"id\": \"1\", \"label\": \"Gather corpus context\", \"order\": 1}, {\"definition\": \"Use configured ontology name matches only when their store hierarchy reaches BFO; retain unaligned-match doubts.\", \"function\": \"src/agents/ontology.py:OntologyAgent._name_matches\", \"id\": \"2\", \"label\": \"Prefer known named classes\", \"order\": 2}, {\"definition\": \"Local-tier category/exclusion and parent passes use type-derived defaults and candidate menus. Frontier-tier _pick_combined is the alternative branch.\", \"function\": \"src/agents/ontology.py:OntologyAgent._pick_split\", \"id\": \"3\", \"label\": \"Choose category and parent\", \"order\": 3}, {\"definition\": \"Preserve canonical IDs; derive domain class IRIs from label/type hashes. Preserve excluded records and flag duplicate identities rather than silently dropping them.\", \"function\": \"src/agents/ontology.py:OntologyAgent.run\", \"id\": \"4\", \"label\": \"Assign stable domain IRIs\", \"order\": 4}, {\"definition\": \"Check parents and cycles, apply configured fallbacks and preserve review information; a parseable fallback is not a validated scientific placement.\", \"function\": \"src/agents/ontology.py:OntologyAgent._repair\", \"id\": \"5\", \"label\": \"Repair hierarchy and fallbacks\", \"order\": 5}, {\"definition\": \"Apply supported paper is_a parent information with category-conflict review safeguards.\", \"function\": \"src/tools/ontology_review.py:paper_parents\", \"id\": \"6\", \"label\": \"Apply evidenced paper parents\", \"order\": 6}, {\"definition\": \"Consider lexical-head corpus parents after repairs; src.run.ontology saves classes, uncertainty and review findings.\", \"function\": \"src/agents/ontology.py:OntologyAgent._lexical_heads\", \"id\": \"7\", \"label\": \"Apply lexical heads and save\", \"order\": 7}], \"bindings\": [{\"argument\": \"concepts\", \"artifact\": \"normalized/concepts.json\", \"direction\": \"input\", \"function\": \"src/agents/ontology.py:OntologyAgent.run\", \"id\": \"concepts\", \"selector\": \"$\", \"transformation\": \"src.run.ontology reads this saved canonical JSON value and passes it unchanged to the corresponding agent argument.\"}, {\"argument\": \"relations\", \"artifact\": \"normalized/relations.json\", \"direction\": \"input\", \"function\": \"src/agents/ontology.py:OntologyAgent.run\", \"id\": \"relations\", \"selector\": \"$\", \"transformation\": \"src.run.ontology reads this saved canonical JSON value and passes it unchanged to the corresponding agent argument.\"}, {\"argument\": \"classes\", \"artifact\": \"ontology/classes.json\", \"direction\": \"output\", \"function\": \"src/run.py:ontology\", \"id\": \"classes\", \"selector\": \"$\", \"transformation\": \"Serialize the returned class list; review issues are written separately.\"}, {\"argument\": \"domain\", \"artifact\": \"run.json\", \"direction\": \"input\", \"function\": \"src/agents/ontology.py:OntologyAgent.run\", \"id\": \"domain\", \"selector\": \"$.collection.name\", \"transformation\": \"Bind the selected nonempty domain name from the run collection context; it forms the domain segment of stable class IRIs.\"}, {\"argument\": \"ontology_review.issues(classes)\", \"artifact\": \"ontology/review_issues.json\", \"direction\": \"output\", \"function\": \"src/run.py:ontology\", \"id\": \"review-issues\", \"selector\": \"$\", \"transformation\": \"Save class-level review findings separately from classes; enrichment later refreshes this shared artifact.\"}], \"checks\": [{\"container\": \"array\", \"id\": \"shape-ontology-classes\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"ontology/classes.json\", \"phases\": [\"after\"], \"required\": {\"excluded\": \"boolean\", \"id\": \"string\", \"iri\": \"string\", \"label\": \"string\", \"parent\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"id\": \"review-findings\", \"instruction\": \"Fallback placement, exclusions and review flags require domain review.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}, {\"container\": \"array\", \"id\": \"canonical-input\", \"kind\": \"shape\", \"nonempty\": true, \"pattern\": \"normalized/concepts.json\", \"phases\": [\"before\"], \"required\": {\"alt_labels\": \"array\", \"definitions\": \"array\", \"id\": \"string\", \"label\": \"string\", \"type\": \"string\"}, \"severity\": \"block\", \"unique\": \"id\"}, {\"id\": \"canonical-class-coverage\", \"kind\": \"identity_coverage\", \"phases\": [\"after\"], \"severity\": \"block\", \"source\": \"normalized/concepts.json\", \"target\": \"ontology/classes.json\"}, {\"allow_iri\": true, \"field\": \"$.parent\", \"id\": \"parent-endpoints\", \"kind\": \"references\", \"live_only\": true, \"pattern\": \"ontology/classes.json\", \"phases\": [\"after\"], \"severity\": \"block\", \"target\": \"ontology/classes.json\"}, {\"id\": \"canonical-input-endpoints\", \"kind\": \"canonical_references\", \"phases\": [\"before\"], \"severity\": \"block\"}], \"input_contract\": {\"description\": \"Canonical concepts and relations are read from normalized files; the nonempty domain is run.manifest.collection.name. No raw paper concept IDs should be supplied here.\", \"initialization\": \"Require the existing ontology store, then construct OntologyAgent(run.ledger) through src.run.ontology or the wrapper stage.\", \"mutation\": \"Constructs new class dictionaries and repairs their hierarchy; source normalized files are not rewritten by the orchestrator.\", \"required_inputs\": {\"concepts[]\": \"id,label,type,alt_labels,definitions and preserved canonical evidence/support fields\", \"domain\": \"nonempty selected domain name\", \"relations[]\": \"canonical s,p,o with evidence/support\"}, \"returns\": [\"list of classes preserving canonical IDs, plus iri,parent,parent_source,excluded and optional review_flags\"], \"source_functions\": [\"src/run.py:ontology\", \"src/agents/ontology.py:OntologyAgent.run\"]}, \"limitation\": \"Fallback placement, exclusions and review flags require domain review.\", \"recovery\": \"Check shared-store readiness and unresolved parents/exclusions; retry placement in a new attempt, then regenerate dependent enrichment and exports.\", \"task\": \"Place canonical concepts and assign IRIs\", \"worked_example\": \"docs/codebase/stages/ontology.md\"}" ;
    kw:coverageStatus "reviewed field-level recipe" ;
    kw:definitionStatus "source-derived description" ;
