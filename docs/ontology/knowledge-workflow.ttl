<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/74575cc36e63e33edeab> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "candidates.json" ;
    skos:definition "Public cross-domain candidate pairs with source-side labels/IRIs, kind, similarity, reviewed flag and decision. A missing decision or cap-limited candidate is not an accepted mapping."@en ;
    kw:artifactPattern "candidates.json" .

<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/80166ef1e51a3ca13ece> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "normalized/causal_order.json" ;
    skos:definition "Graph-derived causal ranks, chains, depth and cycles used for corpus exploration; a structural summary rather than validated causal inference."@en ;
    kw:artifactPattern "normalized/causal_order.json" .

<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/8f7946ecb49980365db8> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "normalized/concept_lineage.json" ;
    skos:definition "Exact paper-key/original-concept-ID to canonical-ID mapping for accepted records, preserving original labels, types, synonyms and canonical labels. Absent in older completed normalizations."@en ;
    kw:artifactPattern "normalized/concept_lineage.json" .

<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/dc0dc0fe21866882a02d> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "normalized/summary.json" ;
    skos:definition "Model-generated corpus summary and themes based on normalized concepts and causal structure; requires comparison with the supporting literature."@en ;
    kw:artifactPattern "normalized/summary.json" .

<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/de895e4ccdecd57f2ebf> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "ontology/imported_definitions.json" ;
    skos:definition "Interoperability import log recording which mapped external definitions/labels were used after enrichment; enriched.json is not rewritten by this stage."@en ;
    kw:artifactPattern "ontology/imported_definitions.json" .

<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/f266088c9a9360be9550> a owl:NamedIndividual,
        kw:ArtifactSpecification ;
    rdfs:label "normalized/corpus_stats.json" ;
    skos:definition "Corpus report statistics computed by reports.corpus_report, including canonical counts, support, tiers, conflicts and coverage. Distinct from NormalizationAgent.run's internal stats field."@en ;
    kw:artifactPattern "normalized/corpus_stats.json" .

