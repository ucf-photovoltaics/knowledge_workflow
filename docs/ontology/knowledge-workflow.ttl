<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/integrate> a owl:NamedIndividual,
        kw:StepSpecification ;
    rdfs:label "Integrate completed domain ontologies" ;
    rdfs:comment "Use explicit selected runs from distinct domains; default latest-run selection can mix historical runs. Master imports formal graphs; merged output unions them. Claims remain separate source-domain layers. At least two successful distinct domains are required." ;
    skos:definition "Use explicit selected runs from distinct domains; default latest-run selection can mix historical runs. Master imports formal graphs; merged output unions them. Claims remain separate source-domain layers. At least two successful distinct domains are required."@en ;
    skos:scopeNote "Cross-domain links are not a replacement for source domain graphs; literature claims remain in their source layers."@en ;
    kw:artifactLocations "[\".\"]" ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Require completed interop, formal export and enriched records, reject duplicate domain runs and record revision mismatch notes.\", \"function\": \"src/tools/integration.py:select_runs\", \"id\": \"1\", \"label\": \"Select explicit distinct domains\", \"order\": 1}, {\"definition\": \"Exclude non-live classes; compute category/parent labels and attach source run/domain context. Parse the full source formal graph independently of the comparison records.\", \"function\": \"src/tools/integration.py:load_domain\", \"id\": \"2\", \"label\": \"Adapt classes and load graphs\", \"order\": 2}, {\"definition\": \"Find cross-domain label/synonym and optional embedding candidates, rank them and assign pair IDs after unusable labels are filtered.\", \"function\": \"src/agents/integration.py:IntegrationAgent._candidates\", \"id\": \"3\", \"label\": \"Generate candidate pairs\", \"order\": 3}, {\"definition\": \"Apply configured review cap, retain unreviewed/missing decisions, guard equivalence and downgrade unsafe claims. Missing decisions can still yield guarded label-based exact mappings.\", \"function\": \"src/agents/integration.py:IntegrationAgent._decide\", \"id\": \"4\", \"label\": \"Review bounded mappings\", \"order\": 4}, {\"definition\": \"Group equivalent/exact/shared-IRI connections across domains. A bridge group is a saved cluster summary, not necessarily a newly minted OWL bridge class.\", \"function\": \"src/agents/integration.py:IntegrationAgent._clusters\", \"id\": \"5\", \"label\": \"Build bridge groups\", \"order\": 5}, {\"definition\": \"Preserve source ontology imports and attach selected cross-domain mappings/provenance to the master graph.\", \"function\": \"src/tools/integration.py:build_master\", \"id\": \"6\", \"label\": \"Build master imports and links\", \"order\": 6}, {\"definition\": \"Check master round trip and integration structure. merge then unions master and all source formal graphs; it does not union domain_layer literature graphs.\", \"function\": \"src/tools/integration.py:validate\", \"id\": \"7\", \"label\": \"Validate and merge formal graphs\", \"order\": 7}, {\"definition\": \"Write exports, public candidates, mappings, bridge summaries, validation, compute/report and manifest source identities; update aggregate evaluation. No source run is modified.\", \"function\": \"src/run.py:integrate\", \"id\": \"8\", \"label\": \"Save provenance and reports\", \"order\": 8}], \"bindings\": [{\"argument\": \"domains\", \"artifact\": \"explicit domain ontology/enriched.json inputs\", \"direction\": \"input\", \"function\": \"src/agents/integration.py:IntegrationAgent.run\", \"id\": \"domains\", \"selector\": \"$\", \"transformation\": \"src.run.integrate selects distinct completed domain runs and constructs domain name to live class list. The artifact text is a descriptive multi-run requirement, not a relative file glob.\"}, {\"argument\": \"s\", \"artifact\": \"explicit selected domain ontology.ttl and run.json inputs\", \"direction\": \"input\", \"function\": \"src/tools/integration.py:load_domain\", \"id\": \"source-graphs\", \"selector\": \"$\", \"transformation\": \"Select readable completed source runs, one per distinct domain, before adapting live classes and parsing formal graphs. Explicit IDs avoid latest-run ambiguity.\"}, {\"argument\": \"integration.public_candidates(result.candidates)\", \"artifact\": \"candidates.json\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"candidates\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"result\", \"artifact\": \"mappings.json\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"mappings\", \"selector\": \"$.mappings\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"result\", \"artifact\": \"bridge_concepts.json\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"bridges\", \"selector\": \"$.clusters\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"integration manifest\", \"artifact\": \"integration.json\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"manifest\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"validation\", \"artifact\": \"validation.json\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"validation\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"master\", \"artifact\": \"<name>.ttl\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"master\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"master\", \"artifact\": \"<name>.jsonld\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"master-jsonld\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"merged\", \"artifact\": \"<name>_merged.ttl\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"merged\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}, {\"argument\": \"integration.report(...)\", \"artifact\": \"integration_report.md\", \"direction\": \"output\", \"function\": \"src/run.py:integrate\", \"id\": \"report\", \"selector\": \"$\", \"transformation\": \"The name is computed from selected domains and recorded in integration.json. Master imports source formal ontologies; merged unions them. Source literature layers remain separate.\"}], \"checks\": [{\"container\": \"object\", \"id\": \"shape-validation\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"validation.json\", \"phases\": [\"after\"], \"required\": {\"valid\": \"boolean\"}, \"severity\": \"block\", \"unique\": null}, {\"container\": \"array\", \"id\": \"mapping-records\", \"kind\": \"shape\", \"pattern\": \"mappings.json\", \"phases\": [\"after\"], \"required\": {\"a_domain\": \"string\", \"a_iri\": \"string\", \"a_run\": \"string\", \"b_domain\": \"string\", \"b_iri\": \"string\", \"b_run\": \"string\", \"relation\": \"string\"}, \"severity\": \"block\"}, {\"container\": \"array\", \"id\": \"bridge-records\", \"kind\": \"shape\", \"pattern\": \"bridge_concepts.json\", \"phases\": [\"after\"], \"required\": {\"domains\": \"array\", \"label\": \"string\", \"members\": \"array\"}, \"severity\": \"block\"}, {\"id\": \"source-readiness\", \"instruction\": \"Bind explicit source run IDs and inspect each completed interop export before creating a new integration. An old integration folder cannot establish readiness of a proposed new selection.\", \"kind\": \"runtime_condition\", \"phases\": [\"before\"], \"severity\": \"runtime\"}, {\"id\": \"mapping-and-bridge-provenance\", \"kind\": \"integration_links\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"structural-validation\", \"kind\": \"saved_validation\", \"pattern\": \"validation.json\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"from_manifest\": true, \"id\": \"master-roundtrip\", \"instruction\": \"Parse local Turtle/JSON-LD exports without fetching imports/remote contexts; compare exact graph equality up to 12000 triples per graph and 40 distinct blank-node identifiers across the pair. Larger comparisons remain unverified review findings.\", \"jsonld\": \"<name>.jsonld\", \"kind\": \"rdf_pair\", \"max_blank_nodes\": 40, \"max_triples\": 12000, \"phases\": [\"after\"], \"severity\": \"block\", \"turtle\": \"<name>.ttl\"}, {\"id\": \"review-findings\", \"instruction\": \"Review capped/unreviewed candidates, missing decisions, exact versus equivalent semantics, downgraded mappings, bridge membership and source freshness. Full source ontologies are preserved in merged formal output; literature layers remain separate.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"description\": \"Select at least two distinct completed domain runs explicitly. load_domain adapts enriched class records into live comparison records and parses each source formal ontology; the agent does not open run folders itself.\", \"initialization\": \"src.run.integrate resolves outputs and explicit run IDs, creates the integration directory and an IntegrationAgent with its own ledger. Wrapper integration selects every configured domain run and a fresh integration ID.\", \"mutation\": \"Reads source runs without rewriting them; writes a new integration folder and updates the aggregate evaluation table. Reusing a CLI integration ID can overwrite its products.\", \"required_inputs\": {\"domains\": \"dict[domain,list[{iri,label,domain,run,alt_labels,category,parent_label,definition,type,score}]]\", \"graphs\": \"dict[domain,{graph,iri}] for master construction\", \"selected[]\": \"one completed run per distinct domain\"}, \"returns\": [\"agent returns candidates,mappings,clusters,stats\", \"orchestrator saves master/imports, merged formal union, mappings/bridges, validation, report and integration manifest\"], \"source_functions\": [\"src/run.py:integrate\", \"src/tools/integration.py:select_runs\", \"src/tools/integration.py:load_domain\", \"src/agents/integration.py:IntegrationAgent.run\"]}, \"limitation\": \"Cross-domain links are not a replacement for source domain graphs; literature claims remain in their source layers.\", \"recovery\": \"Resolve missing/duplicate-domain source runs, stale source revisions and validation failures; create a new integration ID after corrected domain exports.\", \"task\": \"Connect explicitly selected domain ontologies\", \"worked_example\": \"docs/codebase/stages/integrate.md\"}" ;
    kw:coverageStatus "reviewed field-level recipe" ;
    kw:definitionStatus "source-derived description" ;
