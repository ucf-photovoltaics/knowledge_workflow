    kw:canAdvanceTo <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/normalize> ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Obtain selected source metadata and parse each PDF under the PyMuPDF lock; the wrapper supplies saved selection/parser adapters.\", \"function\": \"src/run.py:extract\", \"id\": \"1\", \"label\": \"Select corpus and parse under lock\", \"order\": 1}, {\"definition\": \"Calculate the text/prompt/model/settings fingerprint; reuse a matching cache with zero new model tokens, otherwise process all text windows.\", \"function\": \"src/agents/extraction.py:ExtractionAgent.run\", \"id\": \"2\", \"label\": \"Check extraction cache\", \"order\": 2}, {\"definition\": \"Regenerate chunk strings from paper sections/title/cited captions under the current extraction profile.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._chunks\", \"id\": \"3\", \"label\": \"Build windows\", \"order\": 3}, {\"definition\": \"Local-tier windows extract concepts first then relations/causal/measurements against numbered concepts; frontier-tier run instead uses the combined prompt. These are alternative branches.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._multi_pass\", \"id\": \"4\", \"label\": \"Extract combined or narrow passes\", \"order\": 4}, {\"definition\": \"Re-ask claims missing a usable quote once, using section text and the concept labels. A filled quote still requires verification.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._fill_evidence\", \"id\": \"5\", \"label\": \"Request missing evidence\", \"order\": 5}, {\"definition\": \"Merge all windows into one concept vocabulary, remap endpoints by IDs/labels/synonyms, retain unresolved-end findings and deduplicate claims.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._merge\", \"id\": \"6\", \"label\": \"Reconcile one paper\", \"order\": 6}, {\"definition\": \"Check evidence word-trigram overlap against source text; attach status and parser figure links. Quote overlap is not entailment or numeric validation.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._finalize\", \"id\": \"7\", \"label\": \"Verify quotes and figure links\", \"order\": 7}, {\"definition\": \"Combine source metadata with agent result and parse_stats, save papers/<key>.json, compute and uncertainty records. Failed papers remain in manifest.corpus.failed; CLI may record partial completion.\", \"function\": \"src/run.py:extract\", \"id\": \"8\", \"label\": \"Persist corpus results and failures\", \"order\": 8}], \"bindings\": [{\"argument\": \"paper\", \"artifact\": \"parsed/*.json\", \"direction\": \"input\", \"function\": \"src/agents/extraction.py:ExtractionAgent.run\", \"id\": \"paper-record\", \"modes\": [\"wrapper\"], \"selector\": \"$\", \"transformation\": \"CLI constructs paper context from selected PDFs and parser output; wrapper can reuse parsed records. This port describes parser context, not independent CLI parse completion.\"}, {\"argument\": \"record\", \"artifact\": \"papers/*.json\", \"direction\": \"output\", \"function\": \"src/run.py:extract\", \"id\": \"paper-output\", \"selector\": \"$\", \"transformation\": \"One finalized record per paper; cache/failed-paper handling belongs to the orchestrator.\"}, {\"argument\": \"papers, selection\", \"artifact\": \"explicit CLI collection selection or wrapper ingestion papers\", \"direction\": \"input\", \"function\": \"src/run.py:extract\", \"id\": \"selected-context\", \"selector\": \"$\", \"transformation\": \"CLI select_papers selects/caches its corpus; wrapper overrides selection and parser adapters to reuse ingestion/parsed products.\"}, {\"argument\": \"run.manifest.corpus\", \"artifact\": \"run.json\", \"direction\": \"output\", \"function\": \"src/run.py:extract\", \"id\": \"selected-manifest\", \"selector\": \"$.corpus\", \"transformation\": \"Record selected items, processed/failed papers and corpus hash separately from each saved paper.\"}, {\"argument\": \"reports.paper_compute(...)\", \"artifact\": \"compute_per_paper.csv\", \"direction\": \"output\", \"function\": \"src/run.py:extract\", \"id\": \"paper-compute\", \"selector\": \"$\", \"transformation\": \"Save per-paper compute from finalized records and ledger summaries; not evidence of scientific quality.\"}], \"checks\": [{\"container\": \"object\", \"id\": \"shape-papers-all\", \"kind\": \"shape\", \"nonempty\": true, \"pattern\": \"papers/*.json\", \"phases\": [\"after\"], \"required\": {\"causal\": \"array\", \"concepts\": \"array\", \"key\": \"string\", \"measurements\": \"array\", \"relations\": \"array\"}, \"severity\": \"block\", \"unique\": null}, {\"id\": \"saved-paper-contract\", \"kind\": \"paper_contract\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"selected-extracted-coverage\", \"kind\": \"corpus_coverage\", \"pattern\": \"papers/*.json\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"review-findings\", \"instruction\": \"Review unevidenced claims, unresolved endpoints, malformed or overly broad concepts, measurement property/entity assignments, figure links and failed calls. Verified text overlap alone is insufficient.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"causal_fields\": [\"cause\", \"effect\", \"polarity\"], \"concept_fields\": {\"id\": \"string\", \"label\": \"string\"}, \"description\": \"One parsed paper dictionary, including source metadata, sections and figures, is passed to the agent. The saved paper record is composed by the orchestrator, not returned wholesale by the agent.\", \"initialization\": \"Instantiate ExtractionAgent(run.ledger) under the configured profile. Use CLI extract for combined selection/parsing/extraction or wrapper extract after separately completed ingestion/parsing.\", \"measurement_fields\": [\"concept\", \"value\"], \"mutation\": \"The agent writes extraction cache and ledger records. src.run.extract writes finalized papers and updates corpus selection/failures; wrapper raises after partial extraction.\", \"relation_fields\": [\"s\", \"p\", \"o\"], \"required_inputs\": {\"paper\": \"{key,title,sections:[{heading,text}],figures:[{id,caption}], source metadata}\", \"saved measurements\": \"concept stores the property concept ID; entity is optional\"}, \"required_paper_fields\": {\"causal\": \"array\", \"concepts\": \"array\", \"key\": \"string\", \"measurements\": \"array\", \"relations\": \"array\"}, \"returns\": [\"concepts\", \"relations\", \"causal\", \"measurements\", \"figures\", \"resolution\", \"unresolved_ends\", \"verification\", \"checks\", \"n_chunks\", \"extraction_tier\", \"extraction_passes\", \"raw_calls\", \"compute\", \"cache_hit on reuse\"], \"source_functions\": [\"src/run.py:extract\", \"src/agents/extraction.py:ExtractionAgent.run\", \"src/agents/extraction.py:ExtractionAgent._finalize\"]}, \"limitation\": \"Quote overlap does not establish entailment; partial CLI extraction may still be recorded complete.\", \"recovery\": \"Inspect failed papers and verification flags; resume/retry extraction under the selected controller before normalization.\", \"task\": \"Create evidence-backed per-paper records\", \"worked_example\": \"docs/codebase/stages/extract.md\"}" ;
    kw:coverageStatus "reviewed field-level recipe" ;
    kw:definitionStatus "source-derived description" ;
