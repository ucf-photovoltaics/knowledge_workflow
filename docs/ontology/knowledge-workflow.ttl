    kw:hasImplementation <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#function/src/figures.py:build>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#function/src/figures.py:main> ;
    kw:hasInvocation <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#invocation/reports/cli>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#invocation/reports/wrapper> ;
    kw:hasOperation <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/1>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/2>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/3>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/4>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/5>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/6>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/reports/7> ;
    kw:hasRecovery <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#recovery/reports> ;
    kw:order 10 ;
    kw:recoveryRule "CLI single-stage commands reattempt that stage in the same run; all --run-id skips recorded completion. Dashboard stage skips completed stages; restart creates a new attempt and preserves upstream/history. Inspect failures and do not mix these semantics." ;
    kw:requiredOutput <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/a22350b28862150572f2>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/a48746cae70c44e7e105>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/bcb3d7751facd01f1f8b> ;
    kw:requiresCompletionOf <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/interop> ;
