<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/reports> a owl:NamedIndividual,
        kw:StepSpecification ;
    rdfs:label "Produce reports and figures" ;
    rdfs:comment "Reports can run after one domain interop; integration is optional, not a prerequisite. Plot failures/skips must be read from index.md/report messages; successful command completion does not mean every plot exists." ;
    skos:definition "Reports can run after one domain interop; integration is optional, not a prerequisite. Plot failures/skips must be read from index.md/report messages; successful command completion does not mean every plot exists."@en ;
    skos:scopeNote "Readable reports do not prove every figure succeeded. Report availability is separate from recorded completion."@en ;
    kw:artifactLocations "[\".\", \"figures\"]" ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Read selected runs and evaluation rows, or use revision/profile filters; collect omissions as notes. A sweep summary overrides run selection to completed domain outcomes.\", \"function\": \"src/figures.py:load_runs\", \"id\": \"1\", \"label\": \"Resolve source selection\", \"order\": 1}, {\"definition\": \"Run configured figure functions plus applicable integration plots. Catch each plot failure, close figures and record its skip so other figures continue.\", \"function\": \"src/figures.py:build\", \"id\": \"2\", \"label\": \"Attempt figures independently\", \"order\": 2}, {\"definition\": \"Write each figure PDF/PNG and plotted-data CSV, then register it for the index/report.\", \"function\": \"src/figures.py:Out.save\", \"id\": \"3\", \"label\": \"Save successful plot bundles\", \"order\": 3}, {\"definition\": \"Preserve figure name and failure/insufficient-data reason. A skip must remain visible during review.\", \"function\": \"src/figures.py:Out.skip\", \"id\": \"4\", \"label\": \"Record skipped figures\", \"order\": 4}, {\"definition\": \"Assemble selected domain and applicable integration summaries from saved rows and source manifests.\", \"function\": \"src/report.py:sweep\", \"id\": \"5\", \"label\": \"Build sweep review tables\", \"order\": 5}, {\"definition\": \"Group successful figures, source descriptions and computed explanatory paragraphs into report sections.\", \"function\": \"src/report.py:sections\", \"id\": \"6\", \"label\": \"Render report sections\", \"order\": 6}, {\"definition\": \"Write sweep_summary.csv, Markdown and HTML reports, including omitted/failed outcomes and skipped figures; figures.build also writes index.md and returns out.folder.\", \"function\": \"src/report.py:write\", \"id\": \"7\", \"label\": \"Publish package and return path\", \"order\": 7}], \"bindings\": [{\"argument\": \"run_ids\", \"artifact\": \"explicit completed run IDs\", \"direction\": \"input\", \"function\": \"src/figures.py:build\", \"id\": \"run-selection\", \"selector\": \"$\", \"transformation\": \"Bind actual selected run IDs; optional integration is separate. Reports write to explicit out_dir.\"}, {\"argument\": \"out_dir\", \"artifact\": \"explicit report output directory\", \"direction\": \"input\", \"function\": \"src/figures.py:build\", \"id\": \"output-folder\", \"selector\": \"$\", \"transformation\": \"Bind the intended report destination; omission falls back to outputs/figures/<revision>. Source scope and destination are distinct.\"}, {\"argument\": \"out.folder\", \"artifact\": \"index.md\", \"direction\": \"output\", \"function\": \"src/figures.py:build\", \"id\": \"index-md\", \"selector\": \"$\", \"transformation\": \"Write the report package alongside successful plot PDF/PNG/CSV files. index.md records skipped figures; file presence is availability, not proof of recorded stage completion.\"}, {\"argument\": \"out.folder\", \"artifact\": \"report.md\", \"direction\": \"output\", \"function\": \"src/figures.py:build\", \"id\": \"report-md\", \"selector\": \"$\", \"transformation\": \"Write the report package alongside successful plot PDF/PNG/CSV files. index.md records skipped figures; file presence is availability, not proof of recorded stage completion.\"}, {\"argument\": \"out.folder\", \"artifact\": \"report.html\", \"direction\": \"output\", \"function\": \"src/figures.py:build\", \"id\": \"report-html\", \"selector\": \"$\", \"transformation\": \"Write the report package alongside successful plot PDF/PNG/CSV files. index.md records skipped figures; file presence is availability, not proof of recorded stage completion.\"}, {\"argument\": \"out.folder\", \"artifact\": \"sweep_summary.csv\", \"direction\": \"output\", \"function\": \"src/figures.py:build\", \"id\": \"sweep_summary-csv\", \"selector\": \"$\", \"transformation\": \"Write the report package alongside successful plot PDF/PNG/CSV files. index.md records skipped figures; file presence is availability, not proof of recorded stage completion.\"}], \"checks\": [{\"id\": \"explicit-source-readiness\", \"instruction\": \"Resolve actual selected completed run IDs and a report destination; inspect source findings and optional integration freshness. This assessor does not generate plots.\", \"kind\": \"runtime_condition\", \"phases\": [\"before\"], \"severity\": \"runtime\"}, {\"id\": \"readable-package\", \"kind\": \"report_package\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"review-findings\", \"instruction\": \"Review skipped figures, empty selections, filtering notes and failed/skipped sweep outcomes; readable HTML does not establish complete coverage or acceptance of upstream scientific claims.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"description\": \"figures.build reads saved results and evaluation tables for explicitly selected run IDs, or revision/profile selection. Integration is optional; sweep_summary can constrain completed selections and retain failed/skipped outcomes.\", \"initialization\": \"Use the trusted src.figures invocation with explicit --outputs, --runs and --out. Wrapper reports selects domains with recorded completed interoperability.\", \"mutation\": \"Writes figure PNG/PDF/CSV and report products in out_dir; source pipeline artifacts are read. Per-figure exceptions become skipped entries without aborting other figures.\", \"required_inputs\": {\"out_dir\": \"explicit new report destination\", \"outputs\": \"root containing selected source runs/evaluation tables\", \"run_ids\": \"explicit actual source IDs; None uses revision/profile filtering\", \"sweep_summary\": \"optional CSV requiring kind,limit,run_id,status,detail\"}, \"returns\": [\"Path to report folder containing index.md, report.md, report.html, sweep_summary.csv and successfully generated figure files\"], \"source_functions\": [\"src/figures.py:build\", \"src/figures.py:load_runs\", \"src/report.py:write\"]}, \"limitation\": \"Readable reports do not prove every figure succeeded. Report availability is separate from recorded completion.\", \"recovery\": \"Read index.md skipped-figure findings; regenerate reports from explicit completed run IDs after repairing source artifacts.\", \"task\": \"Publish an inspectable review package\", \"worked_example\": \"docs/codebase/stages/reports.md\"}" ;
    kw:coverageStatus "reviewed field-level recipe" ;
    kw:definitionStatus "source-derived description" ;
    kw:expectsInput <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/909abe5ed30b7e73b1da>,
