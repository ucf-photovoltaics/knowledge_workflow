        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/ontology/4>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/ontology/5>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/ontology/6>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#operation/ontology/7> ;
