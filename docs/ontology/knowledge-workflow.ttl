<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/interop> a owl:NamedIndividual,
        kw:StepSpecification ;
    rdfs:label "Map, export and validate domain layers" ;
    rdfs:comment "Export formal OWL classes separately from literature claims. Quote matches and structural validity do not establish semantic correctness. Review mapping category compatibility, confidence and evidence." ;
    skos:definition "Export formal OWL classes separately from literature claims. Quote matches and structural validity do not establish semantic correctness. Review mapping category compatibility, confidence and evidence."@en ;
    skos:scopeNote "Structural validation does not validate every scientific claim or mapping."@en ;
    kw:artifactLocations "[\".\"]" ;
    kw:canAdvanceTo <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/integrate>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/reports> ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Choose mappings from enriched candidates using recorded methods, guards and mapping semantics; candidates alone are not accepted mappings.\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.align\", \"id\": \"1\", \"label\": \"Commit external alignments\", \"order\": 1}, {\"definition\": \"Import appropriate mapped labels/definitions into in-memory classes and return an explicit import log.\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.import_definitions\", \"id\": \"2\", \"label\": \"Import mapped definitions\", \"order\": 2}, {\"definition\": \"Tag applicable process/study/domain facets and local properties; retain missing/failed row findings.\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.tag_facets\", \"id\": \"3\", \"label\": \"Assign MDS facets\", \"order\": 3}, {\"definition\": \"Construct formal classes/properties, hierarchy, supported restrictions, selected mappings, source provenance and store imports.\", \"function\": \"src/tools/owl.py:build\", \"id\": \"4\", \"label\": \"Build formal OWL\", \"order\": 4}, {\"definition\": \"Serialize the same graph to JSON-LD/Turtle, run structural and mapping checks, and return metrics and sidecars. A false validation result is still saved by the runtime.\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"id\": \"5\", \"label\": \"Serialize and validate formal graph\", \"order\": 5}, {\"definition\": \"Use canonical concepts/claims and papers to create a separate evidence-preserving domain layer; do not assume every literature relation became an OWL axiom.\", \"function\": \"src/tools/bottomup.py:build\", \"id\": \"6\", \"label\": \"Build separate literature claims\", \"order\": 6}, {\"definition\": \"Save both layers and sidecars; refresh interop compute record before ontology_report reads it, then return final stage statistics for the controller to record.\", \"function\": \"src/run.py:interop\", \"id\": \"7\", \"label\": \"Save exports and report\", \"order\": 7}], \"bindings\": [{\"argument\": \"classes\", \"artifact\": \"ontology/enriched.json\", \"direction\": \"input\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"id\": \"classes\", \"selector\": \"$\", \"transformation\": \"Read the saved JSON value; papers is assembled by Run.papers(). Other context arguments come from the selected run, not model-generated text.\"}, {\"argument\": \"properties\", \"artifact\": \"ontology/properties.json\", \"direction\": \"input\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"id\": \"properties\", \"selector\": \"$\", \"transformation\": \"Read the saved JSON value; papers is assembled by Run.papers(). Other context arguments come from the selected run, not model-generated text.\"}, {\"argument\": \"papers\", \"artifact\": \"papers/*.json\", \"direction\": \"input\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"id\": \"papers\", \"selector\": \"$\", \"transformation\": \"Read the saved JSON value; papers is assembled by Run.papers(). Other context arguments come from the selected run, not model-generated text.\"}, {\"argument\": \"out\", \"artifact\": \"ontology.ttl\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"export-turtle\", \"selector\": \"$.turtle\", \"transformation\": \"Serialize the returned result field; domain_layer is built separately by bottomup.build.\"}, {\"argument\": \"out\", \"artifact\": \"ontology.jsonld\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"export-jsonld\", \"selector\": \"$.jsonld\", \"transformation\": \"Serialize the returned result field; domain_layer is built separately by bottomup.build.\"}, {\"argument\": \"out\", \"artifact\": \"ontology/mappings.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"export-mappings\", \"selector\": \"$.mappings\", \"transformation\": \"Serialize the returned result field; domain_layer is built separately by bottomup.build.\"}, {\"argument\": \"out\", \"artifact\": \"ontology/validation.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"export-validation\", \"selector\": \"$.validation\", \"transformation\": \"Serialize the returned result field; domain_layer is built separately by bottomup.build.\"}, {\"argument\": \"domain\", \"artifact\": \"run.json\", \"direction\": \"input\", \"function\": \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"id\": \"domain\", \"selector\": \"$.collection.name\", \"transformation\": \"Bind selected domain name; run_id is run.id from the owning Run object.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/concepts.json\", \"direction\": \"input\", \"function\": \"src/tools/bottomup.py:build\", \"id\": \"layer-concepts\", \"selector\": \"$\", \"transformation\": \"Add this canonical list to norm for the separate literature-claims layer. Runtime falls back to [] if absent; the stricter documentation boundary requires all four to avoid silent loss.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/relations.json\", \"direction\": \"input\", \"function\": \"src/tools/bottomup.py:build\", \"id\": \"layer-relations\", \"selector\": \"$\", \"transformation\": \"Add this canonical list to norm for the separate literature-claims layer. Runtime falls back to [] if absent; the stricter documentation boundary requires all four to avoid silent loss.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/causal.json\", \"direction\": \"input\", \"function\": \"src/tools/bottomup.py:build\", \"id\": \"layer-causal\", \"selector\": \"$\", \"transformation\": \"Add this canonical list to norm for the separate literature-claims layer. Runtime falls back to [] if absent; the stricter documentation boundary requires all four to avoid silent loss.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/measurements.json\", \"direction\": \"input\", \"function\": \"src/tools/bottomup.py:build\", \"id\": \"layer-measurements\", \"selector\": \"$\", \"transformation\": \"Add this canonical list to norm for the separate literature-claims layer. Runtime falls back to [] if absent; the stricter documentation boundary requires all four to avoid silent loss.\"}, {\"argument\": \"layer\", \"artifact\": \"domain_layer.ttl\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"claims-turtle\", \"selector\": \"$\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"layer\", \"artifact\": \"domain_layer.jsonld\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"claims-jsonld\", \"selector\": \"$\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"layer_metrics\", \"artifact\": \"ontology/domain_layer_metrics.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"claims-metrics\", \"selector\": \"$\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"out\", \"artifact\": \"ontology/imported_definitions.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"imports\", \"selector\": \"$.imported_definitions\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"out\", \"artifact\": \"ontology/facets.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"facets\", \"selector\": \"$.facets\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"out\", \"artifact\": \"ontology/metrics.json\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"metrics\", \"selector\": \"$.metrics\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}, {\"argument\": \"reports.ontology_report(...)\", \"artifact\": \"ontology_report.md\", \"direction\": \"output\", \"function\": \"src/run.py:interop\", \"id\": \"report\", \"selector\": \"$\", \"transformation\": \"Save this stage product separately; preserve the distinction between formal OWL, literature claims, imported definitions, facets and report metrics.\"}], \"checks\": [{\"container\": \"object\", \"id\": \"shape-ontology-validation\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"ontology/validation.json\", \"phases\": [\"after\"], \"required\": {\"valid\": \"boolean\"}, \"severity\": \"block\", \"unique\": null}, {\"id\": \"review-findings\", \"instruction\": \"Structural validation does not validate every scientific claim or mapping.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}, {\"container\": \"object\", \"id\": \"properties-input\", \"kind\": \"shape\", \"pattern\": \"ontology/properties.json\", \"phases\": [\"before\"], \"required\": {}, \"severity\": \"block\"}, {\"container\": \"array\", \"id\": \"mapping-records\", \"kind\": \"shape\", \"pattern\": \"ontology/mappings.json\", \"phases\": [\"after\"], \"required\": {\"id\": \"string\", \"iri\": \"string\", \"relation\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"field\": \"$.id\", \"id\": \"mapping-local-ids\", \"kind\": \"references\", \"pattern\": \"ontology/mappings.json\", \"phases\": [\"after\"], \"severity\": \"block\", \"target\": \"ontology/enriched.json\"}, {\"id\": \"structural-validation\", \"kind\": \"saved_validation\", \"pattern\": \"ontology/validation.json\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"formal-roundtrip\", \"instruction\": \"Parse local Turtle/JSON-LD exports without fetching imports/remote contexts; compare exact graph equality up to 12000 triples per graph and 40 distinct blank-node identifiers across the pair. Larger comparisons remain unverified review findings.\", \"jsonld\": \"ontology.jsonld\", \"kind\": \"rdf_pair\", \"max_blank_nodes\": 40, \"max_triples\": 12000, \"phases\": [\"after\"], \"severity\": \"block\", \"turtle\": \"ontology.ttl\"}, {\"id\": \"claims-roundtrip\", \"instruction\": \"Parse local Turtle/JSON-LD exports without fetching imports/remote contexts; compare exact graph equality up to 12000 triples per graph and 40 distinct blank-node identifiers across the pair. Larger comparisons remain unverified review findings.\", \"jsonld\": \"domain_layer.jsonld\", \"kind\": \"rdf_pair\", \"max_blank_nodes\": 40, \"max_triples\": 12000, \"phases\": [\"after\"], \"severity\": \"block\", \"turtle\": \"domain_layer.ttl\"}, {\"id\": \"canonical-input-endpoints\", \"kind\": \"canonical_references\", \"phases\": [\"before\"], \"severity\": \"block\"}, {\"allow_iri\": true, \"field\": \"$.parent\", \"id\": \"placed-input-parents\", \"kind\": \"references\", \"live_only\": true, \"pattern\": \"ontology/enriched.json\", \"phases\": [\"before\"], \"severity\": \"block\", \"target\": \"ontology/enriched.json\"}], \"input_contract\": {\"description\": \"The agent receives enriched class dictionaries, a local property dictionary, saved source papers, run ID and domain. The orchestrator separately rereads normalized concepts/claims to build the literature layer.\", \"initialization\": \"Require the existing store and use InteroperabilityAgent(run.ledger) through src.run.interop. Preserve source run context for provenance.\", \"mutation\": \"Agent alignment/import/facet passes mutate the in-memory class records; src.run.interop does not rewrite enriched.json afterward. Persisted mapping/definition/facet sidecars record these later decisions.\", \"required_inputs\": {\"classes[]\": \"enriched placed class records\", \"norm\": \"separate canonical concepts/relations/causal/measurements dictionary for bottomup.build\", \"papers[]\": \"Run.papers() persisted records\", \"properties\": \"dictionary, not list\", \"run_id/domain\": \"selected run context\"}, \"returns\": [\"mappings\", \"facets\", \"checks\", \"jsonld\", \"turtle\", \"validation\", \"imported_definitions\", \"metrics\", \"bottomup.build separately returns (Graph, metrics)\"], \"source_functions\": [\"src/run.py:interop\", \"src/agents/interoperability.py:InteroperabilityAgent.run\", \"src/tools/bottomup.py:build\"]}, \"limitation\": \"Structural validation does not validate every scientific claim or mapping.\", \"recovery\": \"Inspect saved validation issues, mappings and imported definitions; repair the originating stage and regenerate exports before integration.\", \"task\": \"Export formal ontology and literature claims\", \"worked_example\": \"docs/codebase/stages/interop.md\"}" ;
