    kw:contractJson "{\"algorithm\": [{\"definition\": \"Inspect status and readiness before considering a rebuild. Runtime process ownership must be established separately.\", \"function\": \"src/tools/ontostore.py:status\", \"id\": \"1\", \"label\": \"Inspect readiness and ownership\", \"order\": 1}, {\"definition\": \"Resolve the configured source or current submission into a cached file; build fingerprints the bytes and detects RDF format.\", \"function\": \"src/tools/ontostore.py:_fetch\", \"id\": \"2\", \"label\": \"Fetch configured sources\", \"order\": 2}, {\"definition\": \"Replace the configured store only under exclusive safe write scope; bulk-load source graphs into Oxigraph and discover versions.\", \"function\": \"src/tools/ontostore.py:build\", \"id\": \"3\", \"label\": \"Load source graphs\", \"order\": 3}, {\"definition\": \"Extract class/property labels, definitions, hierarchy and mappings from the loaded store.\", \"function\": \"src/tools/ontostore.py:_extract\", \"id\": \"4\", \"label\": \"Extract term records\", \"order\": 4}, {\"definition\": \"Write the SQLite term index used by read-only ontology retrieval.\", \"function\": \"src/tools/ontostore.py:_write_index\", \"id\": \"5\", \"label\": \"Write searchable index\", \"order\": 5}, {\"definition\": \"Embed indexed term descriptions when configured, then persist vectors and embedding recipe information.\", \"function\": \"src/tools/ontostore.py:_write_vectors\", \"id\": \"6\", \"label\": \"Build optional vectors\", \"order\": 6}, {\"definition\": \"Write source hashes, counts and embedding metadata, reset process caches and return the manifest. require checks file presence only, so inspect status for fuller readiness.\", \"function\": \"src/tools/ontostore.py:build\", \"id\": \"7\", \"label\": \"Save manifest and inspect status\", \"order\": 7}], \"bindings\": [{\"argument\": \"ONTOLOGY_SOURCES\", \"artifact\": \"explicit configured ontology source specifications\", \"direction\": \"input\", \"function\": \"src/tools/ontostore.py:build\", \"id\": \"sources\", \"selector\": \"$\", \"transformation\": \"Resolve source configuration in the trusted runtime. This is not a run-relative artifact glob.\"}, {\"argument\": \"manifest\", \"artifact\": \"configured ONTOLOGY_STORE (default outputs/cache/ontology_store/)\", \"direction\": \"output\", \"function\": \"src/tools/ontostore.py:build\", \"id\": \"store\", \"selector\": \"$\", \"transformation\": \"The returned manifest describes sources/index/embedding recipe; the store is shared and has no per-domain stage record.\"}], \"checks\": [{\"id\": \"exclusive-ready-store\", \"instruction\": \"Inspect the actual configured store status and exclusive safe write scope. This assessor never opens, builds or repairs the shared store.\", \"kind\": \"runtime_condition\", \"phases\": [\"before\", \"after\"], \"severity\": \"runtime\"}], \"input_contract\": {\"description\": \"Shared ontology sources and configured store location. Building is destructive to an existing store directory; first inspect status and establish exclusive ownership.\", \"initialization\": \"Use ontologies status first. Build only when needed and no active process uses shared assets; do not run a build as an ordinary per-domain retry.\", \"mutation\": \"build removes an existing configured store directory, downloads/caches source files, writes Oxigraph, SQLite index, vectors and manifest, and resets process caches.\", \"required_inputs\": {\"EMBED\": \"optional embedding settings\", \"ONTOLOGY_SOURCES\": \"configured source specifications\", \"ONTOLOGY_STORE\": \"configured shared output directory\"}, \"returns\": [\"manifest dictionary; status reports readiness separately\"], \"source_functions\": [\"src/tools/ontostore.py:build\", \"src/tools/ontostore.py:status\", \"src/tools/ontostore.py:require\"]}, \"limitation\": \"Store readiness and exclusive safe write scope require runtime confirmation.\", \"recovery\": \"Inspect configured DB/manifest and status; build only a missing/unusable store when no active job uses it.\", \"task\": \"Establish shared ontology-store readiness\", \"worked_example\": \"docs/codebase/stages/store.md\"}" ;
