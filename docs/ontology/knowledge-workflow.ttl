<https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/parse> a owl:NamedIndividual,
        kw:StepSpecification ;
    rdfs:label "Parse PDFs and prepare text windows" ;
    rdfs:comment "Retain captions and source pages, remove recurring headers/reference sections, save PDF hashes and chunk windows. Chunk windows are temporary inputs, not separate paper ontologies." ;
    skos:definition "Retain captions and source pages, remove recurring headers/reference sections, save PDF hashes and chunk windows. Chunk windows are temporary inputs, not separate paper ontologies."@en ;
    skos:scopeNote "Retained captions do not establish exact bounding boxes or assertion correctness."@en ;
    kw:artifactLocations "[\".\"]" ;
    kw:canAdvanceTo <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/extract> ;
    kw:completionRule "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion." ;
    kw:contractJson "{\"algorithm\": [{\"definition\": \"Load ingestion papers and fingerprint each PDF. Reuse an existing parsed record only when its recorded PDF hash matches.\", \"function\": \"dpv_dashboard/worker.py:parse\", \"id\": \"1\", \"label\": \"Resolve selected PDFs and hashes\", \"order\": 1}, {\"definition\": \"Read text blocks, remove short repeated headers/footers and page numbers, detect headings and omit configured back matter.\", \"function\": \"src/tools/pdf_parse.py:parse\", \"id\": \"2\", \"label\": \"Clean and section PDF text\", \"order\": 2}, {\"definition\": \"Capture figure number, one-based page and caption; attach up to three citing sentences. No image crop or exact bounding box is produced here.\", \"function\": \"src/tools/pdf_parse.py:parse\", \"id\": \"3\", \"label\": \"Retain captions and mentions\", \"order\": 3}, {\"definition\": \"Pack adjacent sections, split oversized text and include title/cited captions within the configured input budget; fail if the budget is too small.\", \"function\": \"src/agents/extraction.py:ExtractionAgent._chunks\", \"id\": \"4\", \"label\": \"Build extraction windows\", \"order\": 4}, {\"definition\": \"Save sections, figures, parse_stats, key/title, PDF hash and chunks. Extraction recalculates chunks from sections rather than trusting saved chunks as its direct argument.\", \"function\": \"dpv_dashboard/worker.py:parse\", \"id\": \"5\", \"label\": \"Persist wrapper intermediates\", \"order\": 5}], \"bindings\": [{\"argument\": \"pdf_path\", \"artifact\": \"ingestion.json\", \"direction\": \"input\", \"function\": \"src/tools/pdf_parse.py:parse\", \"id\": \"pdf-path\", \"modes\": [\"wrapper\"], \"selector\": \"$.papers[*].pdf\", \"transformation\": \"For each selected paper, read the PDF path; wrapper saves parser/chunker output in parsed/<key>.json.\"}, {\"argument\": \"paper\", \"artifact\": \"ingestion.json\", \"direction\": \"input\", \"function\": \"src/agents/extraction.py:ExtractionAgent._chunks\", \"id\": \"chunks\", \"modes\": [\"wrapper\"], \"selector\": \"$.papers\", \"transformation\": \"Combine each selected paper title with parsed sections/figures; the worker passes this in-memory dictionary to the configured chunker.\"}, {\"argument\": \"parsed, digest, chunks\", \"artifact\": \"parsed/*.json\", \"direction\": \"output\", \"function\": \"dpv_dashboard/worker.py:parse\", \"id\": \"parsed-record\", \"selector\": \"$\", \"transformation\": \"Persist parser fields plus key/title, SHA256 of the PDF and chunk strings. These separate products are wrapper-specific.\"}], \"checks\": [{\"container\": \"object\", \"id\": \"shape-parsed-all\", \"kind\": \"shape\", \"modes\": [\"wrapper\"], \"nonempty\": false, \"pattern\": \"parsed/*.json\", \"phases\": [\"after\"], \"required\": {\"chunks\": \"array\", \"key\": \"string\", \"pdf_hash\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"container\": \"array\", \"id\": \"parser-sections\", \"kind\": \"shape\", \"modes\": [\"wrapper\"], \"nonempty\": true, \"pattern\": \"parsed/*.json\", \"phases\": [\"after\"], \"required\": {\"heading\": \"string\", \"text\": \"string\"}, \"selector\": \"$.sections\", \"severity\": \"block\"}, {\"container\": \"array\", \"id\": \"parser-figures\", \"kind\": \"shape\", \"modes\": [\"wrapper\"], \"pattern\": \"parsed/*.json\", \"phases\": [\"after\"], \"required\": {\"caption\": \"string\", \"id\": \"string\"}, \"selector\": \"$.figures\", \"severity\": \"block\", \"unique\": \"id\"}, {\"id\": \"selected-parsed-coverage\", \"kind\": \"corpus_coverage\", \"modes\": [\"wrapper\"], \"pattern\": \"parsed/*.json\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"review-findings\", \"instruction\": \"Review retained text, missing captions, scanned PDFs, over-aggressive back-matter removal and window sizes. Text extraction is not OCR or figure localization.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"description\": \"Selected paper PDF paths come from wrapper ingestion.json. The deterministic parser returns sections, figures and parse_stats; the wrapper separately hashes PDFs and calculates chunks.\", \"initialization\": \"Use worker stage parse after ingestion. It constructs only the chunker profile, without a model instance; CLI extract performs this operation internally.\", \"mutation\": \"Reads PDFs and writes parsed/<key>.json. An existing matching PDF hash skips work; that shortcut does not fingerprint chunker profile changes.\", \"required_inputs\": {\"figures[]\": \"parser {id,label,page,caption,mentions} records\", \"paper.pdf\": \"local PDF path from ingestion papers\", \"sections[]\": \"parser {heading,text} records\"}, \"returns\": [\"parse(pdf_path): {sections,figures,parse_stats}\", \"_chunks(paper): list[str]\", \"worker.parse: None; persisted parser record\"], \"source_functions\": [\"dpv_dashboard/worker.py:parse\", \"src/tools/pdf_parse.py:parse\", \"src/agents/extraction.py:ExtractionAgent._chunks\"]}, \"limitation\": \"Retained captions do not establish exact bounding boxes or assertion correctness.\", \"recovery\": \"Inspect missing/corrupt PDFs and PDF hashes; retry parsing for affected inputs before extraction.\", \"task\": \"Prepare text windows without extracting claims\", \"worked_example\": \"docs/codebase/stages/parse.md\"}" ;
    kw:coverageStatus "reviewed field-level recipe" ;
    kw:definitionStatus "source-derived description" ;
    kw:expectsInput <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/12a9fc28e05d19380417>,
        <https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifact-pattern/85c0a5c4dbbb9771f0e2> ;
