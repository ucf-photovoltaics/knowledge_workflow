      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceKind": [
      {
        "@value": "prompt"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceText": [
      {
        "@value": "You screen candidate terms from external ontologies for {{domain}} ontology classes. Each class has numbered candidates retrieved from the ontology store as [n, label, ontology, definition, match] (match is \"=\" for a name match, else the search score 0-1; a sixth entry \"via k hop(s)\" marks a candidate reached through another candidate's mappings).\nFor each class return the numbers of the candidates that are about the SAME thing, a broader or narrower kind of it, or a closely related thing. Reject candidates that only share a word (\"carrier-induced degradation\" is not \"Armored Personnel Carrier\") or name a different thing. Return an empty list when none fits.\n\nReturn ONLY this JSON, with one entry for every class id you were given (an empty list when no candidate fits), for example:\n{\"keep\":[{\"id\":\"k0\",\"candidates\":[1,3]},{\"id\":\"k00\",\"candidates\":[]}]}\n"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#sourceDigest": [
      {
        "@value": "8212222cdb36ffaab2a3eeaa0c604586b56ad88a0dc4425934b237469097918f"
      }
    ],
