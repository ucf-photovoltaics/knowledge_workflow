      {
        "@language": "en",
        "@value": "Callable test_sweep_retries_skips_and_continues defined in tests/test_sweep.py, with signature (tmp_path, extended, last_limit, shell_name). Its behavioral contract is not curated; inspect the implementation before invoking it directly."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#callTargetText": [
      {
        "@value": "'\\n$global:attempts = @{}\\nfunction global:Start-Sleep { param($Seconds) }\\nfunction global:uv {\\n    $tokens = @($args)\\n    if ($tokens -contains \\'-c\\') {\\n        $index = [Array]::IndexOf($tokens, \\'-c\\')\\n        & \\'PYTHON_EXECUTABLE\\' -c $tokens[$index + 1] $tokens[$index + 2]\\n        $global:LASTEXITCODE = $LASTEXITCODE\\n        return\\n    }\\n    if ($tokens -contains \\'src.figures\\') {\\n        $global:LASTEXITCODE = 0\\n        \\'report fixture completed\\'\\n        return\\n    }\\n    $id = $tokens[[Array]::IndexOf($tokens, \\'--run-id\\') + 1]\\n    $count = 1\\n    if ($global:attempts.ContainsKey($id)) { $count = $global:attempts[$id] + 1 }\\n    $global:attempts[$id] = $count\\n    $global:LASTEXITCODE = 0\\n    if ($id -like \\'tea-n5-*\\' -and $count -eq 1) {\\n        \\'APIConnectionError: transient\\'; $global:LASTEXITCODE = 1; return\\n    }\\n    if ($id -like \\'tea-n5-*\\' -and $tokens[[Array]::IndexOf($tokens, \\'--workers\\') + 1] -ne \\'1\\') {\\n        throw \\'Retry failed to use one worker\\'\\n    }\\n    if ($id -like \\'reliability-n5-*\\' -or $id -like \\'integration-n15-*\\') {\\n        \\'ValueError: terminal fixture error\\'; $global:LASTEXITCODE = 1; return\\n    }\\n    $dir = Join-Path $PWD \"outputs\\\\$id\"\\n    New-Item -ItemType Directory -Force -Path $dir | Out-Null\\n    if ($id -like \\'integration-*\\') {\\n        \\'{\"valid\":true,\"types\":{\"\":2}}\\' | Set-Content (Join-Path $dir \\'validation.json\\')\\n        $inputs = $tokens[([Array]::IndexOf($tokens, \\'--runs\\') + 1)..($tokens.Count - 1)]\\n        $inputs -join \\',\\' | Set-Content (Join-Path $dir \\'inputs.txt\\')\\n    } else {\\n        $n = [int]$tokens[[Array]::IndexOf($tokens, \\'--limit\\') + 1]\\n        $failed = @()\\n        if ($id -like \\'si-topcon-n10-*\\') { $failed = @(@{ key=\\'failed-paper\\' }) }\\n        $json = @{ stages=@{interop=@{valid=$true}}; corpus=@{processed=$n;failed=$failed} } |\\n            ConvertTo-Json -Depth 6\\n        (\\'{\"types\":{\"\":84},\\' + $json.Substring(1)) |\\n            Set-Content (Join-Path $dir \\'run.json\\')\\n    }\\n    \"completed $id\"\\n}\\n& \"$PSScriptRoot\\\\scripts\\\\run-sweep.ps1\" -SweepId fixture EXTENDED\\nexit $LASTEXITCODE\\n'.replace"
      },
      {
        "@value": "'\\n$global:attempts = @{}\\nfunction global:Start-Sleep { param($Seconds) }\\nfunction global:uv {\\n    $tokens = @($args)\\n    if ($tokens -contains \\'-c\\') {\\n        $index = [Array]::IndexOf($tokens, \\'-c\\')\\n        & \\'PYTHON_EXECUTABLE\\' -c $tokens[$index + 1] $tokens[$index + 2]\\n        $global:LASTEXITCODE = $LASTEXITCODE\\n        return\\n    }\\n    if ($tokens -contains \\'src.figures\\') {\\n        $global:LASTEXITCODE = 0\\n        \\'report fixture completed\\'\\n        return\\n    }\\n    $id = $tokens[[Array]::IndexOf($tokens, \\'--run-id\\') + 1]\\n    $count = 1\\n    if ($global:attempts.ContainsKey($id)) { $count = $global:attempts[$id] + 1 }\\n    $global:attempts[$id] = $count\\n    $global:LASTEXITCODE = 0\\n    if ($id -like \\'tea-n5-*\\' -and $count -eq 1) {\\n        \\'APIConnectionError: transient\\'; $global:LASTEXITCODE = 1; return\\n    }\\n    if ($id -like \\'tea-n5-*\\' -and $tokens[[Array]::IndexOf($tokens, \\'--workers\\') + 1] -ne \\'1\\') {\\n        throw \\'Retry failed to use one worker\\'\\n    }\\n    if ($id -like \\'reliability-n5-*\\' -or $id -like \\'integration-n15-*\\') {\\n        \\'ValueError: terminal fixture error\\'; $global:LASTEXITCODE = 1; return\\n    }\\n    $dir = Join-Path $PWD \"outputs\\\\$id\"\\n    New-Item -ItemType Directory -Force -Path $dir | Out-Null\\n    if ($id -like \\'integration-*\\') {\\n        \\'{\"valid\":true,\"types\":{\"\":2}}\\' | Set-Content (Join-Path $dir \\'validation.json\\')\\n        $inputs = $tokens[([Array]::IndexOf($tokens, \\'--runs\\') + 1)..($tokens.Count - 1)]\\n        $inputs -join \\',\\' | Set-Content (Join-Path $dir \\'inputs.txt\\')\\n    } else {\\n        $n = [int]$tokens[[Array]::IndexOf($tokens, \\'--limit\\') + 1]\\n        $failed = @()\\n        if ($id -like \\'si-topcon-n10-*\\') { $failed = @(@{ key=\\'failed-paper\\' }) }\\n        $json = @{ stages=@{interop=@{valid=$true}}; corpus=@{processed=$n;failed=$failed} } |\\n            ConvertTo-Json -Depth 6\\n        (\\'{\"types\":{\"\":84},\\' + $json.Substring(1)) |\\n            Set-Content (Join-Path $dir \\'run.json\\')\\n    }\\n    \"completed $id\"\\n}\\n& \"$PSScriptRoot\\\\scripts\\\\run-sweep.ps1\" -SweepId fixture EXTENDED\\nexit $LASTEXITCODE\\n'.replace('EXTENDED', extended).replace"
