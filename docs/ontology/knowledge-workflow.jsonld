        "@value": "{\"adds\": [\"readable summaries and figures\"], \"from\": [\"formal\", \"claims\", \"integrated\"], \"functions\": [\"src/figures.py:build\", \"src/report.py:write\"], \"id\": \"report\", \"label\": \"Summarize results and review findings\", \"limitation\": \"Reports summarize selected results; they do not replace source evidence or establish complete figure coverage.\", \"omits\": [\"integration is optional\", \"individual plots can fail or be skipped\"], \"optional_from\": [\"integrated\"], \"preserves\": [\"selected run scope\", \"plotted numbers in CSV\", \"skipped-figure findings\"], \"stage\": \"reports\", \"to\": [\"reports\"]}"
