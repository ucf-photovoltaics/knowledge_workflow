    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Load ingestion papers and fingerprint each PDF. Reuse an existing parsed record only when its recorded PDF hash matches."
      },
      {
        "@language": "en",
        "@value": "Save sections, figures, parse_stats, key/title, PDF hash and chunks. Extraction recalculates chunks from sections rather than trusting saved chunks as its direct argument."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#callTargetText": [
      {
        "@value": "Path"
      },
      {
        "@value": "Path(paper['pdf']).read_bytes"
