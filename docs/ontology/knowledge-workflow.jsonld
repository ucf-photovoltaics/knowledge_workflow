    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceText": [
      {
        "@value": "{\n \"type\": \"object\",\n \"required\": [\n  \"causal\"\n ],\n \"properties\": {\n  \"causal\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n     \"cause\",\n     \"effect\",\n     \"polarity\"\n    ],\n    \"properties\": {\n     \"cause\": {\n      \"type\": \"string\"\n     },\n     \"effect\": {\n      \"type\": \"string\"\n     },\n     \"polarity\": {\n      \"enum\": [\n       \"increases\",\n       \"decreases\",\n       \"causes\",\n       \"enables\",\n       \"prevents\",\n       \"affects\"\n      ]\n     },\n     \"condition\": {\n      \"type\": \"string\"\n     },\n     \"evidence\": {\n      \"type\": \"string\"\n     }\n    }\n   }\n  },\n  \"new_concepts\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n     \"id\",\n     \"label\",\n     \"type\"\n    ],\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\",\n      \"description\": \"n1, n2, ...\"\n     },\n     \"label\": {\n      \"type\": \"string\"\n     },\n     \"type\": {\n      \"enum\": [\n       \"material\",\n       \"device\",\n       \"equipment\",\n       \"process\",\n       \"parameter\",\n       \"phenomenon\",\n       \"property\",\n       \"quantity\",\n       \"method\",\n       \"defect\",\n       \"condition\",\n       \"information\"\n      ]\n     }\n    }\n   }\n  }\n }\n}"
      }
    ],
