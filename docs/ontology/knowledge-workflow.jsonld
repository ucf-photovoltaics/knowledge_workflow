    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#journeyDefinitionJson": [
      {
        "@value": "{\"author\": \"Brent Thompson <brent.thompson@ucf.edu>\", \"main_path\": [\"papers\", \"text\", \"extracted\", \"canonical\", \"placed\", \"enriched\", \"formal\", \"integrated\", \"reports\"], \"scope\": \"Specifications of information representations and their source-reviewed transformations. These are not domain entities or claims that an execution occurred.\", \"states\": [{\"artifacts\": [\"ingestion.json\"], \"description\": \"A ranked corpus with source identities and available PDFs.\", \"fields\": [\"paper key\", \"title / DOI\", \"collection memberships\", \"citations\", \"PDF path\"], \"id\": \"papers\", \"label\": \"Selected papers\", \"note\": \"Dashboard ingestion saves this separately. CLI extraction records selection in run.json.\", \"stage\": \"ingest\"}, {\"artifacts\": [\"parsed/*.json\"], \"description\": \"Cleaned sections, caption records and temporary extraction windows.\", \"fields\": [\"section heading / text\", \"figure ID / caption / page\", \"PDF hash\", \"chunks\"], \"id\": \"text\", \"label\": \"Text and captions\", \"note\": \"Windows are temporary model inputs, not separate paper ontologies. Saved parsed files are wrapper-specific.\", \"stage\": \"parse\"}, {\"artifacts\": [\"papers/*.json\"], \"description\": \"One reconciled record per paper; concept IDs are local to that paper.\", \"fields\": [\"paper key + concept ID\", \"concept label / synonyms\", \"relations / causal claims\", \"measurements\", \"quotes / verification\", \"figure links\"], \"id\": \"extracted\", \"label\": \"Paper concepts and claims\", \"note\": \"c1 in one paper does not identify c1 in another. Quote verification measures text overlap, not entailment.\", \"stage\": \"extract\"}, {\"artifacts\": [\"normalized/concepts.json\", \"normalized/relations.json\", \"normalized/causal.json\", \"normalized/measurements.json\", \"normalized/concept_lineage.json\"], \"description\": \"Cross-paper concepts with aliases, supporting papers and remapped claims.\", \"fields\": [\"canonical concept ID\", \"label / alt_labels\", \"supporting paper keys\", \"canonical claim endpoints\", \"importance / contradictions\", \"original identities and label_sources\"], \"id\": \"canonical\", \"label\": \"Canonical vocabulary\", \"note\": \"New normalizations save exact original-to-canonical identities and label provenance. Older runs without the sidecar cannot recover every merge from aliases and supporting papers.\", \"stage\": \"normalize\"}, {\"artifacts\": [\"ontology/classes.json\"], \"description\": \"Canonical records acquire parent decisions and stable domain IRIs.\", \"fields\": [\"canonical ID retained\", \"class IRI\", \"parent / parent_source\", \"excluded\", \"review flags\"], \"id\": \"placed\", \"label\": \"Placed ontology classes\", \"note\": \"A BFO/CCO-connected hierarchy does not establish that every parent decision is scientifically correct.\", \"stage\": \"ontology\"}, {\"artifacts\": [\"ontology/enriched.json\", \"ontology/properties.json\", \"ontology/review_issues.json\"], \"description\": \"Live classes gain definitions, supported restrictions and external candidates.\", \"fields\": [\"definition / basis / source\", \"restrictions + evidence\", \"disjointness\", \"mapping candidates\", \"review flags\"], \"id\": \"enriched\", \"label\": \"Definitions and restrictions\", \"note\": \"Candidates are not committed mappings. Generated, draft and supported definitions have different authority.\", \"stage\": \"enrich\"}, {\"artifacts\": [\"ontology.ttl\", \"ontology.jsonld\", \"ontology/mappings.json\", \"ontology/imported_definitions.json\", \"ontology/facets.json\"], \"description\": \"OWL classes, hierarchy, restrictions and committed external mappings.\", \"fields\": [\"class IRIs\", \"OWL axioms\", \"mapping semantics\", \"imported definitions\", \"source provenance\"], \"id\": \"formal\", \"label\": \"Formal domain ontology\", \"note\": \"Interoperability can update in-memory definitions and facets without rewriting enriched.json; inspect its sidecars.\", \"stage\": \"interop\"}, {\"artifacts\": [\"integration.json\", \"mappings.json\", \"bridge_concepts.json\", \"<name>_merged.ttl\"], \"description\": \"Selected domain graphs are imported and united, with reviewed cross-domain links.\", \"fields\": [\"explicit source run IDs\", \"source class IRIs retained\", \"cross-domain mappings\", \"bridge groups\", \"master imports / formal union\"], \"id\": \"integrated\", \"label\": \"Cross-domain ontology\", \"note\": \"The merged formal graph preserves source ontologies. Bridge groups summarize connections; they are not necessarily new OWL classes.\", \"stage\": \"integrate\"}, {\"artifacts\": [\"index.md\", \"report.md\", \"report.html\", \"sweep_summary.csv\"], \"description\": \"Readable summaries and plots assembled from selected saved results.\", \"fields\": [\"selected run IDs\", \"plotted CSV values\", \"review findings\", \"skipped figures\"], \"id\": \"reports\", \"label\": \"Reports and figures\", \"note\": \"Reports can be generated for a single domain without integration. Report availability is distinct from recorded completion.\", \"stage\": \"reports\"}, {\"artifacts\": [\"domain_layer.ttl\", \"domain_layer.jsonld\"], \"description\": \"Evidence-bearing scientific claims remain separate from formal OWL assertions.\", \"fields\": [\"canonical concepts\", \"reported relations / values\", \"paper provenance\", \"claim evidence\"], \"id\": \"claims\", \"label\": \"Literature-claims layer\", \"note\": \"This layer is not automatically unioned into the integration's merged formal ontology. Keep source domain layers accessible.\", \"stage\": \"interop\"}], \"transformations\": [{\"adds\": [\"sections\", \"parse statistics\", \"bounded text windows\"], \"from\": [\"papers\"], \"functions\": [\"src/tools/pdf_parse.py:parse\", \"src/agents/extraction.py:ExtractionAgent._chunks\"], \"id\": \"parse\", \"label\": \"Extract text and retain captions\", \"limitation\": \"A text window is not a separately saved micro-ontology.\", \"omits\": [\"recurring headers and back matter\", \"page geometry is not retained as exact evidence bounds\"], \"preserves\": [\"paper identity through the orchestrator\", \"caption figure number and page\"], \"stage\": \"parse\", \"to\": [\"text\"]}, {\"adds\": [\"paper-local concepts and claim endpoints\", \"quote-overlap verification status\"], \"from\": [\"text\"], \"functions\": [\"src/agents/extraction.py:ExtractionAgent.run\", \"src/agents/extraction.py:ExtractionAgent._merge\", \"src/agents/extraction.py:ExtractionAgent._finalize\"], \"id\": \"extract\", \"label\": \"Extract and reconcile within each paper\", \"limitation\": \"Verified quote overlap is not scientific entailment. Saved measurement concept identifies its property concept.\", \"omits\": [\"failed or unresolved model outputs may not become usable claims\"], \"preserves\": [\"paper context\", \"retained evidence quotes and figure references\"], \"stage\": \"extract\", \"to\": [\"extracted\"]}, {\"adds\": [\"canonical IDs\", \"cross-paper support and ranks\", \"contradiction findings\", \"saved original-to-canonical identity map\"], \"from\": [\"extracted\"], \"functions\": [\"src/agents/normalization.py:NormalizationAgent.run\", \"src/agents/normalization.py:_aggregate\", \"src/agents/normalization.py:NormalizationAgent._lineage\"], \"id\": \"normalize\", \"label\": \"Merge aliases and remap claims\", \"limitation\": \"Recorded lineage is available for new normalizations. The legacy n15 example still uses reconstructed candidates because its saved run predates the sidecar.\", \"omits\": [\"aggregation retains limited evidence, not necessarily every quote\"], \"preserves\": [\"supporting paper identities\", \"reviewed aliases as alternate labels\", \"retained claim evidence\", \"original paper-local identities and original-label provenance\"], \"stage\": \"normalize\", \"to\": [\"canonical\"]}, {\"adds\": [\"parent choice / source\", \"class IRI\", \"exclusion and review decisions\"], \"from\": [\"canonical\"], \"functions\": [\"src/agents/ontology.py:OntologyAgent.run\"], \"id\": \"place\", \"label\": \"Assign parents and domain IRIs\", \"limitation\": \"Fallback parents and unresolved placement flags require review.\", \"omits\": [\"excluded records are retained but do not become live classes\"], \"preserves\": [\"canonical concept IDs and supporting-paper fields\"], \"stage\": \"ontology\", \"to\": [\"placed\"]}, {\"adds\": [\"definition basis/status\", \"restrictions and candidates\", \"disjointness and material annotations\"], \"from\": [\"placed\", \"canonical\"], \"functions\": [\"src/agents/enrichment.py:EnrichmentAgent.run\"], \"id\": \"enrich\", \"label\": \"Enrich classes from claims and ontology sources\", \"limitation\": \"The agent returns (classes, properties); generated text and external candidates remain reviewable.\", \"omits\": [\"unsupported or incompatible restriction candidates are rejected\"], \"preserves\": [\"canonical IDs / class IRIs\", \"source support on accepted restrictions\"], \"stage\": \"enrich\", \"to\": [\"enriched\"]}, {\"adds\": [\"committed mappings\", \"imported labels/definitions\", \"facets and structural validation\"], \"from\": [\"enriched\", \"extracted\"], \"functions\": [\"src/agents/interoperability.py:InteroperabilityAgent.run\", \"src/tools/owl.py:build\"], \"id\": \"export\", \"label\": \"Commit mappings and export formal OWL\", \"limitation\": \"Mapping and definition sidecars record later in-memory changes; enriched.json is not a complete final export record.\", \"omits\": [\"not every extracted scientific claim is asserted as an OWL axiom\"], \"preserves\": [\"live class IRIs\", \"paper provenance\", \"accepted formal restrictions\"], \"stage\": \"interop\", \"to\": [\"formal\"]}, {\"adds\": [\"a separate evidence-bearing RDF claims layer\"], \"from\": [\"canonical\", \"extracted\"], \"functions\": [\"src/tools/bottomup.py:build\"], \"id\": \"claims\", \"label\": \"Preserve the literature claims separately\", \"limitation\": \"Claims remain reported literature assertions; they do not acquire scientific validity through RDF export.\", \"omits\": [\"this layer is not automatically included in the merged formal integration\"], \"preserves\": [\"canonical claim endpoints\", \"supporting papers and retained evidence\"], \"stage\": \"interop\", \"to\": [\"claims\"]}, {\"adds\": [\"cross-domain mappings\", \"bridge summaries\", \"master ontology imports\"], \"from\": [\"formal\"], \"functions\": [\"src/tools/integration.py:load_domain\", \"src/agents/integration.py:IntegrationAgent.run\", \"src/tools/integration.py:build_master\", \"src/tools/integration.py:merge\"], \"id\": \"integrate\", \"label\": \"Connect selected domain ontologies\", \"limitation\": \"A class can be in the merged ontology without receiving a cross-domain mapping.\", \"omits\": [\"excluded classes are not compared\", \"review caps leave some candidates unreviewed\", \"source literature layers remain separate\"], \"preserves\": [\"full selected source formal graphs in merged output\", \"source run/domain identities and IRIs\"], \"stage\": \"integrate\", \"to\": [\"integrated\"]}, {\"adds\": [\"readable summaries and figures\"], \"from\": [\"formal\", \"claims\", \"integrated\"], \"functions\": [\"src/figures.py:build\", \"src/report.py:write\"], \"id\": \"report\", \"label\": \"Summarize results and review findings\", \"limitation\": \"Reports summarize selected results; they do not replace source evidence or establish complete figure coverage.\", \"omits\": [\"integration is optional\", \"individual plots can fail or be skipped\"], \"optional_from\": [\"integrated\"], \"preserves\": [\"selected run scope\", \"plotted numbers in CSV\", \"skipped-figure findings\"], \"stage\": \"reports\", \"to\": [\"reports\"]}]}"
      }
    ]
  },
