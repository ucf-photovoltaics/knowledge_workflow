        "@value": "{\n \"type\": \"object\",\n \"required\": [\n  \"measurements\"\n ],\n \"properties\": {\n  \"measurements\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n     \"property\",\n     \"value\"\n    ],\n    \"properties\": {\n     \"property\": {\n      \"type\": \"string\",\n      \"description\": \"concept id of the property, parameter or quantity\"\n     },\n     \"entity\": {\n      \"type\": \"string\",\n      \"description\": \"concept id of the thing measured on, if named\"\n     },\n     \"value\": {\n      \"type\": \"string\"\n     },\n     \"unit\": {\n      \"type\": \"string\"\n     },\n     \"condition\": {\n      \"type\": \"string\",\n      \"description\": \"stated context (temperature, illumination, sample state)\"\n     },\n     \"evidence\": {\n      \"type\": \"string\"\n     }\n    }\n   }\n  },\n  \"new_concepts\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n     \"id\",\n     \"label\",\n     \"type\"\n    ],\n    \"properties\": {\n     \"id\": {\n      \"type\": \"string\",\n      \"description\": \"n1, n2, ...\"\n     },\n     \"label\": {\n      \"type\": \"string\"\n     },\n     \"type\": {\n      \"enum\": [\n       \"material\",\n       \"device\",\n       \"equipment\",\n       \"process\",\n       \"parameter\",\n       \"phenomenon\",\n       \"property\",\n       \"quantity\",\n       \"method\",\n       \"defect\",\n       \"condition\",\n       \"information\"\n      ]\n     }\n    }\n   }\n  }\n }\n}\n"
      }
    ],
