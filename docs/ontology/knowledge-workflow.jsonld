  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resource/src/resources/prompts/ontology_category.md",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#ResourceSpecification",
