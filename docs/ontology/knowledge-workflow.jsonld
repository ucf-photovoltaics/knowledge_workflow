        "@value": "{\n  \"type\": \"object\",\n  \"required\": [\"concepts\", \"relations\", \"causal\", \"measurements\", \"figures\"],\n  \"properties\": {\n    \"concepts\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"id\", \"label\", \"type\"], \"properties\": {\n      \"id\": {\"type\": \"string\", \"description\": \"c1, c2, ...\"},\n      \"label\": {\"type\": \"string\"},\n      \"type\": {\"enum\": [\"material\", \"device\", \"equipment\", \"process\", \"parameter\", \"phenomenon\", \"property\", \"quantity\", \"method\", \"defect\", \"condition\", \"information\"]},\n      \"definition\": {\"type\": \"string\"},\n      \"synonyms\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n      \"figures\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"description\": \"F<n>\"}}}}},\n    \"relations\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"s\", \"p\", \"o\"], \"properties\": {\n      \"s\": {\"type\": \"string\"},\n      \"p\": {\"enum\": [\"is_a\", \"part_of\", \"has_part\", \"composed_primarily_of\", \"derived_from\", \"transformation_of\", \"has_quality\", \"has_disposition\", \"has_function\", \"has_role\", \"capable_of\", \"has_input\", \"has_output\", \"input_of\", \"output_of\", \"participates_in\", \"has_participant\", \"located_in\", \"occurs_in\", \"adjacent_to\", \"connected_to\", \"precedes\", \"measured_by\", \"measures\", \"is_about\", \"regulates\", \"realizes\", \"correlated_with\", \"related_to\"]},\n      \"o\": {\"type\": \"string\"},\n      \"evidence\": {\"type\": \"string\"}}}},\n    \"causal\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"cause\", \"effect\", \"polarity\"], \"properties\": {\n      \"cause\": {\"type\": \"string\"},\n      \"effect\": {\"type\": \"string\"},\n      \"polarity\": {\"enum\": [\"increases\", \"decreases\", \"causes\", \"enables\", \"prevents\", \"affects\"]},\n      \"condition\": {\"type\": \"string\