  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/preflight",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#StepSpecification",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Verify collection names, model and embeddings, accessible PDFs and ontology services. This command makes provider/network checks; it is not a no-network validator."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Check environment and sources"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Verify collection names, model and embeddings, accessible PDFs and ontology services. This command makes provider/network checks; it is not a no-network validator."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Printed checks do not create a stage completion record."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifactLocations": [
      {
        "@value": "[\".\"]"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#canAdvanceTo": [
      {
        "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/ingest"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#completionRule": [
      {
        "@value": "Read every printed check and require the final ready message with no [FAIL] lines. src.run.check catches check failures and does not guarantee a nonzero exit code; exit status alone is insufficient."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#contractJson": [
      {
        "@value": "{\"algorithm\": [{\"definition\": \"Check presence of required credential names in the selected runtime without publishing their values.\", \"function\": \"src/run.py:check.keys\", \"id\": \"1\", \"label\": \"Check required credentials\", \"order\": 1}, {\"definition\": \"Make a small real chat request and require a parseable JSON reply; this checks connectivity, not extraction quality.\", \"function\": \"src/run.py:check.model\", \"id\": \"2\", \"label\": \"Probe extraction model\", \"order\": 2}, {\"definition\": \"If embedding is enabled, request a vector; otherwise explicitly report lexical-only operation.\", \"function\": \"src/run.py:check.embeddings\", \"id\": \"3\", \"label\": \"Probe optional embeddings\", \"order\": 3}, {\"definition\": \"Select citation-ranked PDFs for the configured collection and require a nonempty corpus. This writes the PDF cache.\", \"function\": \"src/run.py:check.corpus\", \"id\": \"4\", \"label\": \"Select and cache a sample corpus\", \"order\": 4}, {\"definition\": \"Parse a selected PDF and report its page, section, figure and retained-text counts.\", \"function\": \"src/run.py:check.parser\", \"id\": \"5\", \"label\": \"Check PDF parsing\", \"order\": 5}, {\"definition\": \"Check MDS portal acronyms and a sample search. check.matportal_check separately checks its optional portal.\", \"function\": \"src/run.py:check.portal\", \"id\": \"6\", \"label\": \"Check ontology portals\", \"order\": 6}, {\"definition\": \"Inspect configured store status/problems; require a built store and no reported problems.\", \"function\": \"src/run.py:check.store\", \"id\": \"7\", \"label\": \"Check shared store\", \"order\": 7}, {\"definition\": \"Catch individual failures and print a final ready or failure-count line. This routine does not guarantee a nonzero failure exit code.\", \"function\": \"src/run.py:check\", \"id\": \"8\", \"label\": \"Read every outcome\", \"order\": 8}], \"bindings\": [{\"argument\": \"args.collection\", \"artifact\": \"explicit configured CLI collection\", \"direction\": \"input\", \"function\": \"src/run.py:check\", \"id\": \"configured-collection\", \"selector\": \"$\", \"transformation\": \"Use an actual configured name; wrapper project credentials and collections are a distinct execution mode.\"}, {\"argument\": \"printed outcomes\", \"artifact\": \"preflight observations in terminal\", \"direction\": \"output\", \"function\": \"src/run.py:check\", \"id\": \"readiness\", \"selector\": \"$\", \"transformation\": \"Eight guarded checks print their outcomes. A zero exit status is insufficient; require no FAIL and the final ready line.\"}], \"checks\": [{\"id\": \"printed-ready\", \"instruction\": \"Perform the configured live check and require all printed checks plus the final ready line; saved domain artifacts cannot prove readiness.\", \"kind\": \"runtime_condition\", \"phases\": [\"before\", \"after\"], \"severity\": \"runtime\"}], \"input_contract\": {\"description\": \"A configured CLI collection and provider settings, not a saved paper corpus. This utility performs real network/model requests and PDF caching.\", \"initialization\": \"Use the trusted CLI check invocation after shared-store readiness; configuration is loaded by the runtime. Never copy secret values into RDF or task output.\", \"mutation\": \"Downloads selected PDFs to the shared cache and contacts services. No run stage is recorded.\", \"required_inputs\": {\"args.collection\": \"existing key in config.COLLECTIONS\", \"runtime\": \"configured credentials, extraction profile, optional embedding profile, portals and existing store\"}, \"returns\": [\"None; printed per-check outcomes and final ready/failure count\"], \"source_functions\": [\"src/run.py:check\"]}, \"limitation\": \"Printed checks do not create a stage completion record.\", \"recovery\": \"Resolve each failed check and rerun preflight. A zero exit code is insufficient; require the printed ready outcome.\", \"task\": \"Inspect printed readiness checks\", \"worked_example\": \"docs/codebase/stages/preflight.md\"}"
      }
    ],
