  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/ingest",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#StepSpecification",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Select personal/group libraries permitted by the key; expand descendants, deduplicate DOI/membership, rank citations across the entire domain, and skip unavailable PDFs. Missing citation counts rank last."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Select literature across collections"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Select personal/group libraries permitted by the key; expand descendants, deduplicate DOI/membership, rank citations across the entire domain, and skip unavailable PDFs. Missing citation counts rank last."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A citation-ranked selected corpus may contain fewer papers when PDFs are unavailable."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifactLocations": [
      {
        "@value": "[\".\"]"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#canAdvanceTo": [
      {
        "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/parse"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#completionRule": [
      {
        "@value": "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#contractJson": [
      {
        "@value": "{\"algorithm\": [{\"definition\": \"Expand selected library/collection records to include descendants before gathering items across the named domain.\", \"function\": \"dpv_dashboard/zotero.py:Libraries.expand\", \"id\": \"1\", \"label\": \"Expand descendant collections\", \"order\": 1}, {\"definition\": \"Merge duplicate paper memberships while retaining source library/item/collection information.\", \"function\": \"dpv_dashboard/zotero.py:deduplicate\", \"id\": \"2\", \"label\": \"Gather and deduplicate papers\", \"order\": 2}, {\"definition\": \"Resolve DOI citation counts through configured providers and cache; missing counts remain explicitly unknown.\", \"function\": \"src/tools/citations.py:counts\", \"id\": \"3\", \"label\": \"Count citations\", \"order\": 3}, {\"definition\": \"Sort all deduplicated papers by citation count, missing counts last and stable key ties; apply one cap across the domain, not one per collection.\", \"function\": \"dpv_dashboard/worker.py:ingest\", \"id\": \"4\", \"label\": \"Rank across the domain\", \"order\": 4}, {\"definition\": \"Reuse cached PDFs or fetch them for each paper source; skip unavailable PDFs and continue down the citation ranking until the cap or candidates are exhausted.\", \"function\": \"src/tools/zotero.py:_fetch_pdf\", \"id\": \"5\", \"label\": \"Find available PDFs\", \"order\": 5}, {\"definition\": \"Require at least one available PDF; save selected paper metadata, source memberships, ranking rules, expanded collections and skipped-PDF findings.\", \"function\": \"dpv_dashboard/worker.py:ingest\", \"id\": \"6\", \"label\": \"Persist selected corpus\", \"order\": 6}], \"bindings\": [{\"argument\": \"chosen\", \"artifact\": \"ingestion.json\", \"direction\": \"output\", \"function\": \"dpv_dashboard/worker.py:ingest\", \"id\": \"selected-corpus\", \"selector\": \"$.papers\", \"transformation\": \"Citation-ranked domain selections are saved by the wrapper, not by the single-collection CLI.\"}, {\"argument\": \"domain\", \"artifact\": \"explicit selected project domain collections and limit\", \"direction\": \"input\", \"function\": \"dpv_dashboard/worker.py:ingest\", \"id\": \"domain-selection\", \"selector\": \"$\", \"transformation\": \"Bind actual key-authorized collection records and the domain cap; do not invent library identifiers.\"}, {\"argument\": \"chosen, skipped\", \"artifact\": \"ingestion.partial.json\", \"direction\": \"output\", \"function\": \"dpv_dashboard/worker.py:ingest\", \"id\": \"partial-selection\", \"selector\": \"$\", \"transformation\": \"After PDF attempts, save selected/skipped_no_pdf progress. A partial file does not establish completion.\"}], \"checks\": [{\"container\": \"object\", \"id\": \"shape-ingestion\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"ingestion.json\", \"phases\": [\"after\"], \"required\": {\"papers\": \"array\", \"selection\": \"object\"}, \"severity\": \"block\", \"unique\": null}, {\"container\": \"array\", \"id\": \"selected-paper-fields\", \"kind\": \"shape\", \"nonempty\": true, \"pattern\": \"ingestion.json\", \"phases\": [\"after\"], \"required\": {\"key\": \"string\", \"pdf\": \"string\", \"sources\": \"array\", \"title\": \"string\"}, \"selector\": \"$.papers\", \"severity\": \"block\", \"unique\": \"key\"}, {\"id\": \"review-findings\", \"instruction\": \"Review selected scope, missing citation counts, skipped PDFs and duplicate memberships. A smaller available corpus is not proof of complete literature coverage.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"description\": \"Dashboard domain selections span key-authorized personal/group libraries and descendant collections. CLI extraction uses its separately configured collection.\", \"initialization\": \"The worker bootstrap selects the project profile, credentials, cache and output root before importing the pipeline. Prefer worker stage ingest; no separate CLI ingest command exists.\", \"mutation\": \"Downloads PDFs into the dashboard cache and writes partial/final selection files in the selected attempt; Zotero source items are read.\", \"required_inputs\": {\"domain.collections\": \"list of {library:{type,id,name}, key, name}\", \"domain.limit\": \"positive citation-ranked per-domain cap\", \"folder\": \"selected wrapper attempt directory\"}, \"returns\": [\"None; ingestion.json and incremental ingestion.partial.json\"], \"source_functions\": [\"dpv_dashboard/worker.py:ingest\", \"dpv_dashboard/zotero.py:Libraries.expand\", \"src/run.py:select_papers\"]}, \"limitation\": \"A citation-ranked selected corpus may contain fewer papers when PDFs are unavailable.\", \"recovery\": \"Check key-authorized libraries, descendant collections, citation ranking and PDF availability; retry ingestion in a new wrapper attempt when selections change.\", \"task\": \"Choose a reproducible domain corpus\", \"worked_example\": \"docs/codebase/stages/ingest.md\"}"
      }
    ],
