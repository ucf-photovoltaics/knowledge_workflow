    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resource/src/resources/prompts/extraction_concepts.md",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#ResourceSpecification",
