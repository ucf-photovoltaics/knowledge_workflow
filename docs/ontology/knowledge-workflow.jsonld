      {
        "@language": "en",
        "@value": "Parse local Turtle/JSON-LD exports without fetching imports/remote contexts; compare exact graph equality up to 12000 triples per graph and 40 distinct blank-node identifiers across the pair. Larger comparisons remain unverified review findings."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#checkRule": [
      {
        "@value": "{\"id\": \"formal-roundtrip\", \"instruction\": \"Parse local Turtle/JSON-LD exports without fetching imports/remote contexts; compare exact graph equality up to 12000 triples per graph and 40 distinct blank-node identifiers across the pair. Larger comparisons remain unverified review findings.\", \"jsonld\": \"ontology.jsonld\", \"kind\": \"rdf_pair\", \"max_blank_nodes\": 40, \"max_triples\": 12000, \"phases\": [\"after\"], \"severity\": \"block\", \"turtle\": \"ontology.ttl\"}"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#evaluatedBy": [
