  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/normalize",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#StepSpecification",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Canonicalize terms and reviewed aliases, merge claims and rank importance. New runs persist exact paper-local original-to-canonical identities and per-label sources. Older runs without the sidecar retain reconstructed or ambiguous dashboard links."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Consolidate vocabulary across papers"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Canonicalize terms and reviewed aliases, merge claims and rank importance. New runs persist exact paper-local original-to-canonical identities and per-label sources. Older runs without the sidecar retain reconstructed or ambiguous dashboard links."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "New normalizations persist exact identities in normalized/concept_lineage.json. Older saved runs lack this sidecar; alternate labels and supporting paper IDs cannot reconstruct every merge. Legacy core checks remain compatible with those runs."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifactLocations": [
      {
        "@value": "[\".\"]"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#canAdvanceTo": [
      {
        "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/ontology"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#completionRule": [
      {
        "@value": "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#contractJson": [
      {
        "@value": "{\"algorithm\": [{\"definition\": \"Normalize model-supplied label/type/definition fields; sanitize relation predicates and causal polarity before grouping.\", \"function\": \"src/agents/normalization.py:_clean_concept\", \"id\": \"1\", \"label\": \"Clean paper fields\", \"order\": 1}, {\"definition\": \"Group equal normalized wording and plural variants. This does not itself authorize synonym merges.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._lexical_groups\", \"id\": \"2\", \"label\": \"Group lexical variants\", \"order\": 2}, {\"definition\": \"Use embeddings for candidate clusters and model review for synonym merges; inspect embedding failure/fallback statistics.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._semantic_merge\", \"id\": \"3\", \"label\": \"Review semantic merges\", \"order\": 3}, {\"definition\": \"Create canonical k IDs, alternate labels, per-label paper sources and the exact paper-local identity map used by claims and persisted lineage.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._canonical\", \"id\": \"4\", \"label\": \"Assign canonical identities\", \"order\": 4}, {\"definition\": \"Validate paper-local concept identities and canonical targets, then produce original/canonical IDs, labels, types and synonyms for the saved lineage sidecar.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._lineage\", \"id\": \"record-lineage\", \"label\": \"Record exact original identities\", \"order\": 5}, {\"definition\": \"Review conflicting canonical type votes with the model.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._settle_types\", \"id\": \"5\", \"label\": \"Resolve type votes\", \"order\": 6}, {\"definition\": \"Remap relation/causal endpoints through the canonical map, combine support and retain limited evidence; measurements are remapped separately in run.\", \"function\": \"src/agents/normalization.py:_aggregate\", \"id\": \"6\", \"label\": \"Join corpus claims\", \"order\": 7}, {\"definition\": \"Keep opposed causal claims for review; _score then ranks concepts by configured evidence and graph signals.\", \"function\": \"src/agents/normalization.py:_contradictions\", \"id\": \"7\", \"label\": \"Flag contradictions and score\", \"order\": 8}, {\"definition\": \"Compute causal ranks/chains and cycles without claiming causal proof.\", \"function\": \"src/agents/normalization.py:_causal_order\", \"id\": \"8\", \"label\": \"Order causal structure\", \"order\": 9}, {\"definition\": \"Generate the corpus summary; src.run.normalize writes returned fields and reports.corpus_report writes summary statistics.\", \"function\": \"src/agents/normalization.py:NormalizationAgent._summarize\", \"id\": \"9\", \"label\": \"Summarize and save\", \"order\": 10}], \"bindings\": [{\"argument\": \"papers\", \"artifact\": \"papers/*.json\", \"direction\": \"input\", \"function\": \"src/agents/normalization.py:NormalizationAgent.run\", \"id\": \"papers\", \"selector\": \"$\", \"transformation\": \"Run.papers() reads sorted JSON files into one list; the agent cleans list contents in memory.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/concepts.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-concepts\", \"selector\": \"$.concepts\", \"transformation\": \"Run.write serializes norm[\\\"concepts\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/relations.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-relations\", \"selector\": \"$.relations\", \"transformation\": \"Run.write serializes norm[\\\"relations\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/causal.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-causal\", \"selector\": \"$.causal\", \"transformation\": \"Run.write serializes norm[\\\"causal\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/measurements.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-measurements\", \"selector\": \"$.measurements\", \"transformation\": \"Run.write serializes norm[\\\"measurements\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/contradictions.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-contradictions\", \"selector\": \"$.contradictions\", \"transformation\": \"Run.write serializes norm[\\\"contradictions\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/causal_order.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-causal_order\", \"selector\": \"$.causal_order\", \"transformation\": \"Run.write serializes norm[\\\"causal_order\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/summary.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-summary\", \"selector\": \"$.summary\", \"transformation\": \"Run.write serializes norm[\\\"summary\\\"] after NormalizationAgent.run returns.\"}, {\"argument\": \"return\", \"artifact\": \"normalized/corpus_stats.json\", \"direction\": \"output\", \"function\": \"src/tools/reports.py:corpus_report\", \"id\": \"corpus-stats\", \"selector\": \"$\", \"transformation\": \"corpus_report produces stats returned to src.run.normalize; Run.write saves stats. This is not a direct serialization of norm.stats.\"}, {\"argument\": \"path\", \"artifact\": \"corpus_report.md\", \"direction\": \"output\", \"function\": \"src/tools/reports.py:corpus_report\", \"id\": \"corpus-report\", \"selector\": \"$\", \"transformation\": \"corpus_report writes the Markdown report as a side effect.\"}, {\"argument\": \"norm\", \"artifact\": \"normalized/concept_lineage.json\", \"direction\": \"output\", \"function\": \"src/run.py:normalize\", \"id\": \"result-concept-lineage\", \"selector\": \"$.concept_lineage\", \"transformation\": \"Run.write serializes the exact paper/original_id to canonical_id mapping returned by NormalizationAgent.run; older saved stages are not backfilled.\"}], \"checks\": [{\"container\": \"array\", \"id\": \"shape-normalized-concepts\", \"kind\": \"shape\", \"nonempty\": true, \"pattern\": \"normalized/concepts.json\", \"phases\": [\"after\"], \"required\": {\"alt_labels\": \"array\", \"id\": \"string\", \"label\": \"string\", \"papers\": \"array\"}, \"severity\": \"block\", \"unique\": \"id\"}, {\"container\": \"array\", \"id\": \"shape-normalized-relations\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"normalized/relations.json\", \"phases\": [\"after\"], \"required\": {\"o\": \"string\", \"p\": \"string\", \"s\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"container\": \"array\", \"id\": \"shape-normalized-causal\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"normalized/causal.json\", \"phases\": [\"after\"], \"required\": {\"cause\": \"string\", \"effect\": \"string\", \"polarity\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"container\": \"array\", \"id\": \"shape-normalized-measurements\", \"kind\": \"shape\", \"nonempty\": false, \"pattern\": \"normalized/measurements.json\", \"phases\": [\"after\"], \"required\": {\"concept\": \"string\", \"value\": \"string\"}, \"severity\": \"block\", \"unique\": null}, {\"id\": \"paper-input\", \"kind\": \"paper_contract\", \"pattern\": \"papers/*.json\", \"phases\": [\"before\"], \"severity\": \"block\"}, {\"id\": \"canonical-references\", \"kind\": \"canonical_references\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"input-output-coverage\", \"kind\": \"paper_coverage\", \"phases\": [\"after\"], \"severity\": \"block\"}, {\"id\": \"aliases-and-contradictions\", \"instruction\": \"Inspect alternate labels, supporting definitions, type votes, contradictions, unsupported measurements and uncertain rows before accepting the vocabulary.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}], \"input_contract\": {\"causal_fields\": [\"cause\", \"effect\", \"polarity\"], \"concept_fields\": {\"id\": \"string\", \"label\": \"string\"}, \"description\": \"Persisted extraction records, not raw model-response JSON. In saved measurements, the property concept ID is in concept (raw extraction schema calls it property).\", \"initialization\": \"Construct NormalizationAgent(run.ledger) in the existing configured runtime. Prefer the trusted CLI/wrapper invocation to direct calls so logging, settings and manifests are handled.\", \"measurement_fields\": [\"concept\", \"value\"], \"mutation\": \"The agent replaces concept/relation/causal lists in its in-memory papers. The orchestrator does not rewrite source papers during normalization.\", \"relation_fields\": [\"s\", \"p\", \"o\"], \"required_paper_fields\": {\"causal\": \"array\", \"concepts\": \"array\", \"key\": \"string\", \"measurements\": \"array\", \"relations\": \"array\"}, \"returns\": [\"concepts\", \"relations\", \"causal\", \"measurements\", \"contradictions\", \"causal_order\", \"summary\", \"stats\"], \"source_functions\": [\"src/run.py:Run.papers\", \"src/agents/normalization.py:NormalizationAgent.run\", \"src/run.py:normalize\", \"src/tools/reports.py:corpus_report\"]}, \"limitation\": \"New normalizations persist exact identities in normalized/concept_lineage.json. Older saved runs lack this sidecar; alternate labels and supporting paper IDs cannot reconstruct every merge. Legacy core checks remain compatible with those runs.\", \"recovery\": \"If paper contracts or references fail, repair/retry extraction in an isolated attempt before rerunning normalization. If normalized products are damaged, restart normalization using the same intact corpus and review all downstream products for staleness.\", \"task\": \"Build the canonical corpus vocabulary\"}"
      }
    ],
