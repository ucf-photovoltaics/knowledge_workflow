        "@value": "{\"adds\": [\"cross-domain mappings\", \"bridge summaries\", \"master ontology imports\"], \"from\": [\"formal\"], \"functions\": [\"src/tools/integration.py:load_domain\", \"src/agents/integration.py:IntegrationAgent.run\", \"src/tools/integration.py:build_master\", \"src/tools/integration.py:merge\"], \"id\": \"integrate\", \"label\": \"Connect selected domain ontologies\", \"limitation\": \"A class can be in the merged ontology without receiving a cross-domain mapping.\", \"omits\": [\"excluded classes are not compared\", \"review caps leave some candidates unreviewed\", \"source literature layers remain separate\"], \"preserves\": [\"full selected source formal graphs in merged output\", \"source run/domain identities and IRIs\"], \"stage\": \"integrate\", \"to\": [\"integrated\"]}"
