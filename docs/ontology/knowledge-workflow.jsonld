  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resource/src/resources/prompts/enrichment_definitions.md",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#ResourceSpecification",
