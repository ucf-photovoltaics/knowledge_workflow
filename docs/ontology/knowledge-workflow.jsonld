  {
    "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/enrich",
    "@type": [
      "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#StepSpecification",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Preserve definition sources/status, evidence restrictions, disjointness and rejected candidates. Generated or draft definitions are not authoritative; external candidates are not accepted mappings."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Add definitions and formal relationships"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Preserve definition sources/status, evidence restrictions, disjointness and rejected candidates. Generated or draft definitions are not authoritative; external candidates are not accepted mappings."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Generated definitions, imported definitions and evidence-supported definitions have different authority."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#artifactLocations": [
      {
        "@value": "[\".\"]"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#canAdvanceTo": [
      {
        "@id": "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#step/interop"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#completionRule": [
      {
        "@value": "Confirm expected artifacts are parseable and inspect the saved stage/error records. Review content; file presence alone is not completion."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#contractJson": [
      {
        "@value": "{\"algorithm\": [{\"definition\": \"Retain excluded records, initialize live definitions/restrictions/disjointness and determine whether the configured profile permits model-knowledge definitions.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent.run\", \"id\": \"1\", \"label\": \"Initialize live class enrichment\", \"order\": 1}, {\"definition\": \"Combine store candidates, bounded portal searches and propagated mappings, preserving source, score, path and label-match distinctions.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._candidates\", \"id\": \"2\", \"label\": \"Gather mapping candidates\", \"order\": 2}, {\"definition\": \"Annotate applicable material classes using configured Materials Project support, retaining lookup evidence and review results.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._materials\", \"id\": \"3\", \"label\": \"Add optional material annotations\", \"order\": 3}, {\"definition\": \"Create local and appropriate RO/CCO causal restrictions for eligible evidence-backed canonical claims.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._causal\", \"id\": \"4\", \"label\": \"Translate evidenced causal claims\", \"order\": 4}, {\"definition\": \"Retrieve object properties for evidenced non-is_a relations and retain only candidates fitting domain and range.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._property_candidates\", \"id\": \"5\", \"label\": \"Resolve scientific property candidates\", \"order\": 5}, {\"definition\": \"Use exact or configured tie-broken property matches directly, leaving other eligible relations for model review.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._predicate_restrictions\", \"id\": \"6\", \"label\": \"Commit deterministic predicate matches\", \"order\": 6}, {\"definition\": \"Apply local split-pass or frontier combined answers; retain definition basis/status, validate restrictions against source relations and flag unsupported results.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._apply\", \"id\": \"7\", \"label\": \"Apply profile-specific enrichment\", \"order\": 7}, {\"definition\": \"After dropping disjointness conflicting with paper is_a, build local property descriptions. The orchestrator unpacks classes/properties and saves sidecars.\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent._local_properties\", \"id\": \"8\", \"label\": \"Check disjointness and persist tuple\", \"order\": 8}], \"bindings\": [{\"argument\": \"classes\", \"artifact\": \"ontology/classes.json\", \"direction\": \"input\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent.run\", \"id\": \"classes\", \"selector\": \"$\", \"transformation\": \"Read the corresponding saved JSON value; pass classes and normalized claims as separate arguments, not a combined ontology graph.\"}, {\"argument\": \"relations\", \"artifact\": \"normalized/relations.json\", \"direction\": \"input\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent.run\", \"id\": \"relations\", \"selector\": \"$\", \"transformation\": \"Read the corresponding saved JSON value; pass classes and normalized claims as separate arguments, not a combined ontology graph.\"}, {\"argument\": \"causal\", \"artifact\": \"normalized/causal.json\", \"direction\": \"input\", \"function\": \"src/agents/enrichment.py:EnrichmentAgent.run\", \"id\": \"causal\", \"selector\": \"$\", \"transformation\": \"Read the corresponding saved JSON value; pass classes and normalized claims as separate arguments, not a combined ontology graph.\"}, {\"argument\": \"classes\", \"artifact\": \"ontology/enriched.json\", \"direction\": \"output\", \"function\": \"src/run.py:enrich\", \"id\": \"output-classes\", \"selector\": \"$\", \"transformation\": \"Unpack the agent tuple (classes, properties), then serialize each component.\"}, {\"argument\": \"properties\", \"artifact\": \"ontology/properties.json\", \"direction\": \"output\", \"function\": \"src/run.py:enrich\", \"id\": \"output-properties\", \"selector\": \"$\", \"transformation\": \"Unpack the agent tuple (classes, properties), then serialize each component.\"}, {\"argument\": \"agent.materials_log\", \"artifact\": \"ontology/materials_project.json\", \"direction\": \"output\", \"function\": \"src/run.py:enrich\", \"id\": \"materials-log\", \"selector\": \"$\", \"transformation\": \"Persist optional Materials Project lookup/annotation results and review provenance.\"}, {\"argument\": \"ontology_review.issues(classes)\", \"artifact\": \"ontology/review_issues.json\", \"direction\": \"output\", \"function\": \"src/run.py:enrich\", \"id\": \"review-issues\", \"selector\": \"$\", \"transformation\": \"Refresh the shared class review findings from enriched classes.\"}, {\"argument\": \"ontology_review.correspondences(...)\", \"artifact\": \"ontology/cross_domain_candidates.json\", \"direction\": \"output\", \"function\": \"src/run.py:enrich\", \"id\": \"cross-domain-candidates\", \"selector\": \"$\", \"transformation\": \"Advisory historical correspondences; these do not replace explicit source-run selection for integration.\"}], \"checks\": [{\"container\": \"array\", \"id\": \"shape-ontology-enriched\", \"kind\": \"shape\", \"live_only\": true, \"nonempty\": false, \"pattern\": \"ontology/enriched.json\", \"phases\": [\"after\"], \"required\": {\"definition\": \"string\", \"definition_status\": \"string\", \"id\": \"string\", \"restrictions\": \"array\"}, \"severity\": \"block\", \"unique\": null}, {\"id\": \"review-findings\", \"instruction\": \"Generated definitions, imported definitions and evidence-supported definitions have different authority.\", \"kind\": \"scientific_review\", \"phases\": [\"after\"], \"severity\": \"review\"}, {\"container\": \"array\", \"id\": \"placed-input\", \"kind\": \"shape\", \"nonempty\": true, \"pattern\": \"ontology/classes.json\", \"phases\": [\"before\"], \"required\": {\"alt_labels\": \"array\", \"definitions\": \"array\", \"excluded\": \"boolean\", \"id\": \"string\", \"iri\": \"string\", \"label\": \"string\", \"parent\": \"string\"}, \"severity\": \"block\", \"unique\": \"id\"}, {\"container\": \"object\", \"id\": \"properties-object\", \"kind\": \"shape\", \"pattern\": \"ontology/properties.json\", \"phases\": [\"after\"], \"required\": {}, \"severity\": \"block\"}, {\"id\": \"placed-enriched-coverage\", \"kind\": \"identity_coverage\", \"phases\": [\"after\"], \"severity\": \"block\", \"source\": \"ontology/classes.json\", \"target\": \"ontology/enriched.json\"}, {\"field\": \"$.restrictions\", \"id\": \"restriction-targets\", \"kind\": \"references\", \"live_only\": true, \"nested_field\": \"o\", \"pattern\": \"ontology/enriched.json\", \"phases\": [\"after\"], \"severity\": \"block\", \"target\": \"ontology/enriched.json\"}, {\"field\": \"$.disjoint_with\", \"id\": \"disjoint-targets\", \"kind\": \"references\", \"live_only\": true, \"pattern\": \"ontology/enriched.json\", \"phases\": [\"after\"], \"severity\": \"block\", \"target\": \"ontology/enriched.json\"}, {\"id\": \"canonical-input-endpoints\", \"kind\": \"canonical_references\", \"phases\": [\"before\"], \"severity\": \"block\"}, {\"allow_iri\": true, \"field\": \"$.parent\", \"id\": \"placed-input-parents\", \"kind\": \"references\", \"live_only\": true, \"pattern\": \"ontology/classes.json\", \"phases\": [\"before\"], \"severity\": \"block\", \"target\": \"ontology/classes.json\"}], \"input_contract\": {\"description\": \"Placed class records and normalized relation/causal lists are independent arguments. Only non-excluded classes are enriched, but all class identities are returned.\", \"initialization\": \"Require the shared ontology store, construct EnrichmentAgent(run.ledger), then call run(classes,relations,causal) via the existing stage.\", \"mutation\": \"Mutates live class dictionaries in memory: initializes definitions/restrictions/disjointness, adds candidates and annotations. The orchestrator saves enriched classes separately from placement classes.\", \"required_inputs\": {\"causal[]\": \"canonical cause,effect,polarity and evidence/support\", \"classes[]\": \"placed canonical fields including id,label,parent,excluded,alt_labels,definitions,iri\", \"relations[]\": \"canonical s,p,o and evidence/support\"}, \"returns\": [\"tuple[classes, properties dictionary]\", \"agent.materials_log and agent.doubts are saved separately\"], \"source_functions\": [\"src/run.py:enrich\", \"src/agents/enrichment.py:EnrichmentAgent.run\"]}, \"limitation\": \"Generated definitions, imported definitions and evidence-supported definitions have different authority.\", \"recovery\": \"Inspect unsupported definitions, failed rows and restrictions dropped; reattempt enrichment and regenerate interop/integration/reports from the new results.\", \"task\": \"Add definitions, restrictions and candidates\", \"worked_example\": \"docs/codebase/stages/enrich.md\"}"
      }
    ],
