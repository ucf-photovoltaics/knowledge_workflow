    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#recoveryRule": [
      {
        "@value": "CLI single-stage commands reattempt that stage in the same run; all --run-id skips recorded completion. Dashboard stage skips completed stages; restart creates a new attempt and preserves upstream/history. Inspect failures and do not mix these semantics."
      }
