      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Source prompt content at src/resources/prompts/extraction_causal.md, linked to its consuming step and protected by a source fingerprint."
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#definitionStatus": [
      {
        "@value": "source-derived description"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceKind": [
      {
        "@value": "prompt"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceText": [
      {
        "@value": "You extract EVERY cause -> effect claim from ONE SECTION of a {{domain}} research paper. This is your only task, so be exhaustive. Be faithful: use only what this text says, in the paper's own words; never add background knowledge. Return ONLY one JSON object that matches the schema at the end. No prose.\n\nCONCEPTS lists the concepts already identified as \"id: label (type)\". Refer to them ONLY by their id. If something you need is missing from the list, add it to new_concepts with an id n1, n2, ... and use that id.\n\nCAUSAL - the most important part. Extract EVERY cause -> effect claim, including:\n- process parameter -> property {{ex:causal_param}};\n- stressor -> degradation {{ex:causal_stressor}};\n- mechanism chains: split \"A leads to B, which reduces C\" into A -> B and B -> C;\n- experimental findings and trends {{ex:causal_finding}}.\n- polarity from the enum; condition = the stated context (temperature, time, climate, bias), else \"\".\n- evidence = verbatim quote of at most 20 words. Direction matters: cause is what changes first.\n- cause and effect MUST be ids from CONCEPTS or new_concepts, never phrases.\n\nSCHEMA\n"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#sourceDigest": [
      {
        "@value": "1b0ccb5a051595a79bab498fa8fa5ed3d61c7d9f5db806d654f54f6abbff1745"
