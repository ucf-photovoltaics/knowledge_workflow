    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#resourceText": [
      {
        "@value": "You settle synonym candidates for a {{domain}} concept list. Each cluster holds terms that an embedding model found similar. Merge only terms that name the SAME concept: synonyms, acronyms, spelling or inflection variants. Do NOT merge broader and narrower terms (for example \"defect\" and \"crack\"), a quantity with its unit, a thing with its property, or opposite terms.\n\nReturn ONLY JSON: {\"merges\":[{\"ids\":[...],\"label\":\"preferred label\"}]}. Each merge uses ids from ONE cluster and has at least 2 ids. The preferred label is the clearest full name (not an acronym). Omit clusters where nothing should merge.\n\nSCHEMA\n"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#sourceDigest": [
      {
        "@value": "7ca8776487cf23eecd9dbecec099c81ab8a3046086553c5b62102edd281f9e31"
      }
    ],
    "https://w3id.org/ucf-dpv/knowledge-workflow/codebase#sourcePath": [
      {
        "@value": "src/resources/prompts/normalization.md"
      }
    ]
  },
