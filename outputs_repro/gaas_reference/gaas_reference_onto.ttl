@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix mds:     <https://cwrusdle.bitbucket.io/mds/> .
@prefix gaas:     <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/> .

<https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/ontology>
    a owl:Ontology ;
    rdfs:label "gaas reference Ontology"@en ;
    dcterms:description "OWL 2 ontology generated from MDS-Onto v5 NLP pipeline outputs for the gaas domain."@en ;
    dcterms:created "2026-06-24"^^xsd:date ;
    dcterms:creator "MDS-Onto v5 NLP Pipeline" ;
    owl:imports <https://cwrusdle.bitbucket.io/mds/> ;
    .

# ── MDS-Onto top-level classes ───────────────────────────

<https://cwrusdle.bitbucket.io/mds/Concept>
    a owl:Class ;
    rdfs:label "Concept"@en ;
    .

<https://cwrusdle.bitbucket.io/mds/Measurement>
    a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Material>
    a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Process>
    a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Device>
    a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Characterization>
    a owl:Class ;
    rdfs:label "Characterization"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Reliability>
    a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Characterization> ;
    .

<https://cwrusdle.bitbucket.io/mds/Sample>
    a owl:Class ;
    rdfs:label "Sample"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/Economics>
    a owl:Class ;
    rdfs:label "Economics"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/Concept> ;
    .

<https://cwrusdle.bitbucket.io/mds/ResearchPublication>
    a owl:Class ;
    rdfs:label "ResearchPublication"@en ;
    .

# ── Domain record class ──────────────────────────────────────

<https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord>
    a owl:Class ;
    rdfs:label "Gaas Schema Record"@en ;
    rdfs:subClassOf <https://cwrusdle.bitbucket.io/mds/ResearchPublication> ;
    skos:definition "Structured record extracted from a research publication in the gaas domain."@en ;
    .

# ── Extracted concept properties ─────────────────────────

<https://cwrusdle.bitbucket.io/mds/measurement/PowerConversionEfficiency>
    a owl:DatatypeProperty ;
    rdfs:label "power conversion efficiency"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Measurement> ;
    .

<https://cwrusdle.bitbucket.io/mds/material/AbsorberMaterial>
    a owl:DatatypeProperty ;
    rdfs:label "absorber material"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    .

<https://cwrusdle.bitbucket.io/mds/process/DepositionMethod>
    a owl:DatatypeProperty ;
    rdfs:label "deposition method"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Process> ;
    .

<https://cwrusdle.bitbucket.io/mds/characterization/DegradationMechanism>
    a owl:DatatypeProperty ;
    rdfs:label "degradation mechanism"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Reliability> ;
    .

<https://cwrusdle.bitbucket.io/mds/economics/MaterialCost>
    a owl:DatatypeProperty ;
    rdfs:label "material cost"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Material> ;
    .

<https://cwrusdle.bitbucket.io/mds/sample/WaferThickness>
    a owl:DatatypeProperty ;
    rdfs:label "wafer thickness"@en ;
    rdfs:domain <https://cwrusdle.bitbucket.io/mds/semiconductors/gaas/SchemaRecord> ;
    rdfs:range xsd:string ;
    skos:broader <https://cwrusdle.bitbucket.io/mds/Sample> ;
    .
